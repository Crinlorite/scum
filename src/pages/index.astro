---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HomeShowcase from '../components/HomeShowcase.astro';
import ServerStatus from '../components/ServerStatus.astro';
import Contribute from '../components/Contribute.astro';
import type { LangCode } from '../i18n/languages';

const lang: LangCode = 'es';
---
<BaseLayout lang={lang}>
  <Hero lang={lang} />
  <HomeShowcase lang={lang} />
  <ServerStatus lang={lang} />
  <Contribute lang={lang} />
</BaseLayout>
