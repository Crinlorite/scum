---
// Dashboard de jugadores + inspector. Usa el sistema compartido (PanelLayout +
// panel.css + scripts/panel.ts). Lee /panel/api/players y /panel/api/player.
import PanelLayout from '../../../layouts/PanelLayout.astro';
import itemsData from '../../../data/items.json';
import iconsData from '../../../data/icons.json';
const iconSet = new Set(iconsData as string[]);
const itemLookup: Record<string, { n: string; s: string; i: number }> = {};
for (const it of itemsData as any[]) {
  itemLookup[it.asset] = { n: (it.name && (it.name.es || it.name.en)) || it.asset, s: it.slug, i: iconSet.has(it.slug) ? 1 : 0 };
}
---
<PanelLayout title="Jugadores" slug="jugadores">
  <button slot="actions" id="refresh" type="button" class="pnl-btn">↻ Actualizar</button>

  <p id="meta" class="pnl-meta"></p>
  <div class="dt-scroll">
    <table class="dt click">
      <thead><tr><th>Jugador</th><th>Estado</th><th>Fama</th><th>Dinero</th><th>Escuadrón</th><th>Conexión</th><th>SteamID</th></tr></thead>
      <tbody id="rows"></tbody>
    </table>
  </div>
  <p class="pnl-hint">Clic en un jugador para ver sus skills e inventario.</p>

  <div id="modal" class="pnl-modal" hidden>
    <div class="pnl-modal-back" data-close></div>
    <div class="pnl-modal-card" role="dialog" aria-modal="true">
      <button class="pnl-modal-x" data-close aria-label="Cerrar">✕</button>
      <div id="modal-body"></div>
    </div>
  </div>

  <script type="application/json" id="item-lookup" set:html={JSON.stringify(itemLookup)}></script>

  <script>
    import { esc, nf, fmtRel, nowTime, requireAdmin } from '../../../scripts/panel.ts';
    const API = '/panel/api';
    const ITEMS = JSON.parse(document.getElementById('item-lookup')!.textContent || '{}');
    const prettySkill = (n) => esc((n || '').replace(/Skill$/, '').replace(/([a-z])([A-Z])/g, '$1 $2'));
    const prettyItem = (c) => esc((c || '').replace(/_ES$/, '').replace(/_/g, ' ').replace(/([a-z])([A-Z])/g, '$1 $2'));
    const online = (p) => p.last_login && p.last_logout && new Date(p.last_login) > new Date(p.last_logout);

    function render(players) {
      document.getElementById('rows').innerHTML = players.map((p) => {
        const estado = p.alive === false ? '<span class="bdg dead">muerto</span>' : '<span class="bdg alive">vivo</span>';
        const conn = online(p) ? '<span class="bdg on">en línea</span>' : '<span class="muted">' + esc(fmtRel(p.last_login)) + '</span>';
        const money = [];
        if (p.money && p.money.cash != null) money.push('<b>' + nf.format(p.money.cash) + '</b> <span class="muted">$</span>');
        if (p.money && p.money.gold) money.push(nf.format(p.money.gold) + ' <span class="muted">oro</span>');
        const squad = p.squad ? esc(p.squad) + ' <span class="muted">·' + (p.squad_rank ?? '') + '</span>' : '<span class="muted">—</span>';
        return `<tr data-sid="${esc(p.steamid)}" tabindex="0">
          <td><span class="name">${esc(p.char_name) || '—'}</span>${p.banned ? ' <span class="bdg bad">ban</span>' : ''}${p.steam_name && p.steam_name !== p.char_name ? `<br><span class="muted">${esc(p.steam_name)}</span>` : ''}</td>
          <td>${estado}</td><td class="num">${p.fame != null ? Math.round(p.fame) : '—'}</td>
          <td class="num">${money.join(' &nbsp; ') || '<span class="muted">—</span>'}</td>
          <td>${squad}</td><td>${conn}</td><td class="sid">${esc(p.steamid)}</td>
        </tr>`;
      }).join('');
    }

    async function load() {
      const btn = document.getElementById('refresh'); btn.disabled = true;
      try {
        const d = await (await fetch(API + '/players')).json();
        const players = (d.players || []).sort((a, b) => Number(online(b)) - Number(online(a)) || (b.fame || 0) - (a.fame || 0));
        render(players);
        document.getElementById('meta').textContent = `${players.length} jugadores · ${players.filter(online).length} en línea · actualizado ${nowTime()}`;
      } catch (e) { document.getElementById('meta').textContent = 'Error al cargar.'; }
      finally { btn.disabled = false; }
    }

    const modal = document.getElementById('modal');
    const closeModal = () => { modal.hidden = true; };
    modal.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeModal));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

    async function inspect(sid) {
      const body = document.getElementById('modal-body');
      body.innerHTML = '<p class="muted">Cargando…</p>'; modal.hidden = false;
      try {
        const res = await fetch(API + '/player?steamid=' + encodeURIComponent(sid));
        if (!res.ok) { body.innerHTML = '<p class="muted">No se pudo cargar (' + res.status + ').</p>'; return; }
        const d = await res.json();
        const skills = (d.skills || []).map((s) =>
          `<li><span class="bn">${prettySkill(s.name)}</span><span class="bb"><i style="width:${Math.min(100, (s.level || 0) / 3 * 100)}%"></i></span><span class="bs">${s.level}</span></li>`).join('') || '<li class="muted">Sin skills.</li>';
        const inv = (d.inventory || []).map((i) => {
          const meta = ITEMS[i.class];
          const name = meta ? esc(meta.n) : prettyItem(i.class);
          const label = meta ? `<a href="/items/${meta.s}" target="_blank" rel="noopener">${name}</a>` : name;
          const icon = meta && meta.i ? `<img class="it-ico" src="/icons/${meta.s}.webp" alt="" width="22" height="22" loading="lazy">` : '<span class="it-ico ph"></span>';
          const h = i.health != null ? Math.round(i.health) : null;
          return `<li>${icon}<span class="it-n">${label}</span>${h != null ? `<span class="it-h">${h}%</span>` : ''}</li>`;
        }).join('') || '<li class="muted">Sin items (offline o inventario vacío).</li>';
        const bk = d.bank || {};
        const extras = [
          bk.cash != null ? `<b class="mono">${nf.format(bk.cash)}</b> $` : null,
          bk.gold ? `${nf.format(bk.gold)} oro` : null,
          d.squad ? `${esc(d.squad.name)}${d.squad.rank != null ? ' (' + d.squad.rank + ')' : ''}` : null,
          d.bases ? `${d.bases} base${d.bases > 1 ? 's' : ''}` : null,
        ].filter(Boolean).join(' · ');
        body.innerHTML = `
          <h2 class="m-name">${esc(d.char_name) || '—'} ${d.alive === false ? '<span class="bdg dead">muerto</span>' : '<span class="bdg alive">vivo</span>'}</h2>
          <p class="m-sub">Fama <b class="mono">${d.fame != null ? Math.round(d.fame) : '—'}</b> · ${d.item_count || 0} items${extras ? ' · ' + extras : ''}</p>
          <div class="m-cols">
            <div><h3>Skills <span class="muted">${(d.skills || []).length}</span></h3><ul class="bars">${skills}</ul></div>
            <div><h3>Inventario <span class="muted">${d.item_count || 0}</span></h3><ul class="ilist">${inv}</ul></div>
          </div>`;
      } catch (e) { body.innerHTML = '<p class="muted">Error de red.</p>'; }
    }

    document.getElementById('rows').addEventListener('click', (e) => { const tr = (e.target as HTMLElement).closest('tr'); if (tr && tr.dataset.sid) inspect(tr.dataset.sid); });
    document.getElementById('rows').addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') { const tr = (e.target as HTMLElement).closest('tr'); if (tr && tr.dataset.sid) inspect(tr.dataset.sid); } });
    document.getElementById('refresh').addEventListener('click', load);
    requireAdmin(load);
  </script>
</PanelLayout>
