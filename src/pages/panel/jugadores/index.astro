---
// Dashboard de jugadores + inspector (panel admin). Lee /panel/api/players y
// /panel/api/player?steamid= (backend host, RO sobre la DB viva, admin-only).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import itemsData from '../../../data/items.json';
import iconsData from '../../../data/icons.json';
// Lookup compacto clase(asset) -> {nombre, slug, tiene-icono} para cruzar el
// inventario con el catálogo de la wiki (nombres + icono + link a /items).
const iconSet = new Set(iconsData as string[]);
const itemLookup: Record<string, { n: string; s: string; i: number }> = {};
for (const it of itemsData as any[]) {
  itemLookup[it.asset] = { n: (it.name && (it.name.es || it.name.en)) || it.asset, s: it.slug, i: iconSet.has(it.slug) ? 1 : 0 };
}
---
<BaseLayout lang="es" title="Jugadores" description="Dashboard de jugadores del servidor" noindex>
  <section class="players">
    <div class="container">
      <header class="ph">
        <div><span class="eyebrow">Panel · Admin</span><h1>Jugadores</h1></div>
        <button id="refresh" type="button" class="refresh">↻ Actualizar</button>
      </header>

      <div id="gate" class="gate" hidden>
        <h2>Solo administradores</h2>
        <p>Este panel requiere permiso de administrador. Si eres moderador, tienes el <a href="/panel/mapa">mapa en vivo</a>.</p>
      </div>

      <div id="wrap" hidden>
        <p id="meta" class="meta"></p>
        <div class="table-scroll">
          <table class="ptable">
            <thead><tr><th>Jugador</th><th>Estado</th><th>Fama</th><th>Dinero</th><th>Escuadrón</th><th>Conexión</th><th>SteamID</th></tr></thead>
            <tbody id="rows"></tbody>
          </table>
        </div>
        <p class="tiphint">Clic en un jugador para ver sus skills e inventario.</p>
      </div>
    </div>
  </section>

  <!-- inspector -->
  <div id="modal" class="modal" hidden>
    <div class="modal-back" data-close></div>
    <div class="modal-card" role="dialog" aria-modal="true">
      <button class="modal-x" data-close aria-label="Cerrar">✕</button>
      <div id="modal-body"></div>
    </div>
  </div>

  <script type="application/json" id="item-lookup" set:html={JSON.stringify(itemLookup)}></script>

  <script>
    const API = '/panel/api';
    const ITEMS = JSON.parse(document.getElementById('item-lookup').textContent || '{}');
    const esc = (s) => (s == null ? '' : String(s)).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
    const nf = new Intl.NumberFormat('es-ES');
    const prettySkill = (n) => esc((n || '').replace(/Skill$/, '').replace(/([a-z])([A-Z])/g, '$1 $2'));
    const prettyItem = (c) => esc((c || '').replace(/_ES$/, '').replace(/_/g, ' ').replace(/([a-z])([A-Z])/g, '$1 $2'));

    function rel(iso) {
      if (!iso) return '—';
      const d = new Date(iso); if (isNaN(d)) return '—';
      const s = (Date.now() - d.getTime()) / 1000;
      if (s < 60) return 'hace segundos';
      if (s < 3600) return 'hace ' + Math.floor(s / 60) + ' min';
      if (s < 86400) return 'hace ' + Math.floor(s / 3600) + ' h';
      return 'hace ' + Math.floor(s / 86400) + ' d';
    }
    const online = (p) => p.last_login && p.last_logout && new Date(p.last_login) > new Date(p.last_logout);

    function render(players) {
      document.getElementById('rows').innerHTML = players.map((p) => {
        const on = online(p);
        const estado = p.alive === false ? '<span class="b dead">muerto</span>' : '<span class="b alive">vivo</span>';
        const conn = on ? '<span class="b on">en línea</span>' : '<span class="muted">' + esc(rel(p.last_login)) + '</span>';
        const money = [];
        if (p.money && p.money.cash != null) money.push('<b>' + nf.format(p.money.cash) + '</b> <span class="muted">$</span>');
        if (p.money && p.money.gold) money.push(nf.format(p.money.gold) + ' <span class="muted">oro</span>');
        const squad = p.squad ? esc(p.squad) + ' <span class="muted">·' + (p.squad_rank ?? '') + '</span>' : '<span class="muted">—</span>';
        return `<tr class="rowc" data-sid="${esc(p.steamid)}" tabindex="0">
          <td><span class="name">${esc(p.char_name) || '—'}</span>${p.banned ? ' <span class="b ban">ban</span>' : ''}${p.steam_name && p.steam_name !== p.char_name ? `<br><span class="muted">${esc(p.steam_name)}</span>` : ''}</td>
          <td>${estado}</td><td>${p.fame != null ? Math.round(p.fame) : '—'}</td>
          <td class="money">${money.join(' &nbsp; ') || '<span class="muted">—</span>'}</td>
          <td>${squad}</td><td>${conn}</td><td class="sid">${esc(p.steamid)}</td>
        </tr>`;
      }).join('');
    }

    async function load() {
      const btn = document.getElementById('refresh'); btn.disabled = true;
      try {
        const res = await fetch(API + '/players');
        if (res.status === 403) { document.getElementById('gate').hidden = false; document.getElementById('wrap').hidden = true; return; }
        const j = await res.json();
        const players = (j.players || []).sort((a, b) => Number(online(b)) - Number(online(a)) || (b.fame || 0) - (a.fame || 0));
        render(players);
        document.getElementById('wrap').hidden = false;
        document.getElementById('meta').textContent = `${players.length} jugadores · ${players.filter(online).length} en línea · actualizado ${new Date().toLocaleTimeString()}`;
      } catch (e) { document.getElementById('meta').textContent = 'Error al cargar.'; }
      finally { btn.disabled = false; }
    }

    // --- inspector ---
    const modal = document.getElementById('modal');
    function closeModal() { modal.hidden = true; }
    modal.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeModal));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

    async function inspect(sid) {
      const body = document.getElementById('modal-body');
      body.innerHTML = '<p class="muted">Cargando…</p>';
      modal.hidden = false;
      try {
        const res = await fetch(API + '/player?steamid=' + encodeURIComponent(sid));
        if (!res.ok) { body.innerHTML = '<p class="muted">No se pudo cargar (' + res.status + ').</p>'; return; }
        const d = await res.json();
        const skills = (d.skills || []).map((s) =>
          `<div class="skill"><span class="sk-n">${prettySkill(s.name)}</span><span class="sk-bar"><i style="width:${Math.min(100, (s.level || 0) / 3 * 100)}%"></i></span><span class="sk-l">${s.level}</span></div>`).join('') || '<p class="muted">Sin skills.</p>';
        const inv = (d.inventory || []).map((i) => {
          const meta = ITEMS[i.class];
          const name = meta ? esc(meta.n) : prettyItem(i.class);
          const label = meta ? `<a href="/items/${meta.s}" target="_blank" rel="noopener">${name}</a>` : name;
          const icon = meta && meta.i
            ? `<img class="it-ico" src="/icons/${meta.s}.webp" alt="" width="22" height="22" loading="lazy">`
            : '<span class="it-ico ph"></span>';
          const h = i.health != null ? Math.round(i.health) : null;
          return `<li>${icon}<span class="it-n">${label}</span>${h != null ? `<span class="it-h">${h}%</span>` : ''}</li>`;
        }).join('') || '<li class="muted">Sin items (offline o inventario vacío).</li>';
        body.innerHTML = `
          <h2 class="m-name">${esc(d.char_name) || '—'} ${d.alive === false ? '<span class="b dead">muerto</span>' : '<span class="b alive">vivo</span>'}</h2>
          <p class="m-sub">Fama <b>${d.fame != null ? Math.round(d.fame) : '—'}</b> · ${d.item_count || 0} items</p>
          <div class="m-cols">
            <div><h3>Skills <span class="muted">${(d.skills || []).length}</span></h3><div class="skills">${skills}</div></div>
            <div><h3>Inventario <span class="muted">${d.item_count || 0}</span></h3><ul class="inv">${inv}</ul></div>
          </div>`;
      } catch (e) { body.innerHTML = '<p class="muted">Error de red.</p>'; }
    }

    document.getElementById('rows').addEventListener('click', (e) => {
      const tr = e.target.closest('.rowc'); if (tr) inspect(tr.dataset.sid);
    });
    document.getElementById('rows').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { const tr = e.target.closest('.rowc'); if (tr) inspect(tr.dataset.sid); }
    });
    document.getElementById('refresh').addEventListener('click', load);
    load();
  </script>

  <style>
    .players { padding: 2.5rem 0 4rem; }
    .ph { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 1.2rem; }
    .ph h1 { margin: 0.2rem 0 0; }
    .refresh { font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.78rem; padding: 0.4rem 0.9rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-paper); color: var(--c-ink-soft); cursor: pointer; }
    .refresh:hover { border-color: var(--c-rust); color: var(--c-ink); }
    .gate { background: var(--c-paper-soft); border: 1px solid var(--c-rule); border-left: 3px solid var(--c-rust); border-radius: var(--radius); padding: 1.5rem; }
    .gate h2 { margin: 0 0 0.4rem; font-family: var(--font-display); }
    .meta { color: var(--c-ink-muted); font-size: 0.82rem; font-family: var(--font-mono); margin: 0 0 0.7rem; }
    .table-scroll { overflow-x: auto; border: 1px solid var(--c-rule); border-radius: var(--radius-lg); }
    .ptable { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    .ptable th { text-align: left; font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.72rem; color: var(--c-ink-muted); padding: 0.7rem 0.9rem; background: var(--c-paper-soft); border-bottom: 1px solid var(--c-rule); }
    .ptable td { padding: 0.7rem 0.9rem; border-bottom: 1px solid var(--c-rule); vertical-align: top; }
    .ptable tr:last-child td { border-bottom: 0; }
    .rowc { cursor: pointer; } .rowc:hover td, .rowc:focus td { background: var(--c-paper-soft); outline: none; }
    .name { font-weight: 600; font-family: var(--font-display); }
    .muted { color: var(--c-ink-muted); font-size: 0.82rem; }
    .money b { font-family: var(--font-mono); }
    .sid { font-family: var(--font-mono); font-size: 0.76rem; color: var(--c-ink-muted); }
    .b { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.04em; padding: 0.1rem 0.4rem; border-radius: 999px; border: 1px solid; }
    .b.alive { color: var(--c-olive); border-color: var(--c-olive); } .b.dead { color: #b3261e; border-color: #b3261e; }
    .b.on { color: #fff; background: var(--c-olive); border-color: var(--c-olive); } .b.ban { color: #b3261e; border-color: #b3261e; }
    .tiphint { color: var(--c-ink-muted); font-size: 0.78rem; margin-top: 0.6rem; }

    /* inspector modal */
    .modal { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; padding: 1rem; }
    .modal[hidden] { display: none; }  /* el atributo hidden lo pisaba display:grid -> el modal bloqueaba la página */
    .modal-back { position: absolute; inset: 0; background: rgba(15,19,17,0.55); backdrop-filter: blur(2px); }
    .modal-card { position: relative; background: var(--c-paper); border-radius: var(--radius-lg); border: 1px solid var(--c-rule); max-width: 720px; width: 100%; max-height: 85vh; overflow-y: auto; padding: 1.6rem 1.7rem; box-shadow: 0 18px 50px rgba(0,0,0,0.3); }
    .modal-x { position: absolute; top: 0.8rem; right: 0.9rem; border: 0; background: none; font-size: 1.1rem; color: var(--c-ink-muted); cursor: pointer; }
    .modal-x:hover { color: var(--c-ink); }
    .m-name { margin: 0 0 0.2rem; font-family: var(--font-display); display: flex; align-items: center; gap: 0.6rem; }
    .m-sub { color: var(--c-ink-soft); margin: 0 0 1rem; font-size: 0.9rem; } .m-sub b { font-family: var(--font-mono); }
    .m-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; }
    @media (max-width: 620px) { .m-cols { grid-template-columns: 1fr; } }
    .m-cols h3 { font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.78rem; color: var(--c-ink-muted); margin: 0 0 0.6rem; border-bottom: 1px solid var(--c-rule); padding-bottom: 0.3rem; }
    .skills { display: grid; gap: 0.35rem; }
    .skill { display: grid; grid-template-columns: 1fr 70px 1.6rem; align-items: center; gap: 0.5rem; font-size: 0.84rem; }
    .sk-bar { background: var(--c-rule); border-radius: 999px; height: 6px; overflow: hidden; }
    .sk-bar i { display: block; height: 100%; background: var(--c-rust); }
    .sk-l { font-family: var(--font-mono); text-align: right; color: var(--c-ink-soft); }
    .inv { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; }
    .inv li { display: flex; align-items: center; gap: 0.5rem; font-size: 0.84rem; padding: 0.25rem 0; border-bottom: 1px dotted var(--c-rule); }
    .it-ico { width: 22px; height: 22px; object-fit: contain; flex: none; } .it-ico.ph { opacity: 0; }
    .it-n { flex: 1; } .it-n a { color: var(--c-link); text-decoration: none; } .it-n a:hover { text-decoration: underline; }
    .it-h { font-family: var(--font-mono); color: var(--c-ink-muted); font-size: 0.78rem; flex: none; }
  </style>
</BaseLayout>
