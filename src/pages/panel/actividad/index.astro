---
// Feed de actividad del servidor (panel admin). Lee /panel/api/activity (backend
// host, RO sobre la DB viva + logs login_*.log, admin-only). Eventos: login,
// logout y muertes (sin causante: el kill.log no es fiable en este server).
// Usa el sistema compartido (PanelLayout + panel.css + scripts/panel.ts).
import PanelLayout from '../../../layouts/PanelLayout.astro';
---
<PanelLayout title="Actividad" slug="actividad">
  <button slot="actions" id="refresh" type="button" class="pnl-btn">↻ Actualizar</button>

  <p id="meta" class="pnl-meta"></p>

  <div class="pnl-actions" style="margin-bottom:1rem">
    <button type="button" class="pnl-btn flt primary" data-flt="all">Todo</button>
    <button type="button" class="pnl-btn flt" data-flt="login">Conexiones</button>
    <button type="button" class="pnl-btn flt" data-flt="logout">Desconexiones</button>
    <button type="button" class="pnl-btn flt" data-flt="death">Muertes</button>
  </div>

  <div class="dt-scroll">
    <table class="dt">
      <thead><tr><th>Evento</th><th>Jugador</th><th>Hora</th></tr></thead>
      <tbody id="feed"></tbody>
    </table>
  </div>
  <p class="pnl-hint">Conexiones desde los logs del servidor; muertes desde la base de datos (sin causante: el registro de kills no es fiable en este servidor). Horas en España (CEST).</p>

  <script>
    import { esc, fmtDateTime, fmtRel, nowTime, requireAdmin } from '../../../scripts/panel.ts';
    const API = '/panel/api';

    const KIND = {
      login:  { bdg: 'on',   txt: 'se conectó' },
      logout: { bdg: 'lvl',  txt: 'se desconectó' },
      death:  { bdg: 'dead', txt: 'murió' },
    };

    let ALL = [];
    let FLT = 'all';

    function render() {
      const evs = FLT === 'all' ? ALL : ALL.filter((e) => e.type === FLT);
      const feed = document.getElementById('feed');
      if (!evs.length) { feed.innerHTML = '<tr><td colspan="3" class="muted">Sin eventos.</td></tr>'; return; }
      feed.innerHTML = evs.map((e) => {
        const k = KIND[e.type] || { bdg: 'lvl', txt: e.type };
        const name = esc(e.char_name) || esc(e.steam_name) || '—';
        const alias = e.steam_name && e.steam_name !== e.char_name ? ` <span class="muted">(${esc(e.steam_name)})</span>` : '';
        return `<tr>
          <td><span class="bdg ${k.bdg}">${esc(k.txt)}</span></td>
          <td><span class="name">${name}</span>${alias}</td>
          <td class="num" title="${esc(fmtRel(e.ts))}">${esc(fmtDateTime(e.ts))}</td>
        </tr>`;
      }).join('');
    }

    async function load() {
      const btn = document.getElementById('refresh'); btn.disabled = true;
      try {
        const res = await fetch(API + '/activity');
        const j = await res.json();
        ALL = (j.events || []).sort((a, b) => (a.ts < b.ts ? 1 : a.ts > b.ts ? -1 : 0));
        const nd = ALL.filter((e) => e.type === 'death').length;
        document.getElementById('meta').textContent =
          `${ALL.length} eventos · ${nd} ${nd === 1 ? 'muerte' : 'muertes'} · actualizado ${nowTime()}`;
        render();
      } catch (e) { document.getElementById('meta').textContent = 'Error al cargar.'; }
      finally { btn.disabled = false; }
    }

    document.getElementById('refresh').addEventListener('click', load);
    document.querySelectorAll('.flt').forEach((b) => b.addEventListener('click', () => {
      FLT = (b as HTMLElement).dataset.flt;
      document.querySelectorAll('.flt').forEach((x) => x.classList.toggle('primary', x === b));
      render();
    }));
    requireAdmin(load);
  </script>
</PanelLayout>
