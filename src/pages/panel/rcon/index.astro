---
// Consola RCON privada (panel admin). Usa el sistema compartido (PanelLayout +
// panel.css + scripts/panel.ts). El gate de admin lo hace PanelLayout; el backend
// además exige is_admin en /panel/api/rcon/*. Navegador de 138 comandos por tier
// + runner (args + confirmación graduada) + terminal de salida.
// Lee la lista desde data/admin.json. Endpoints: POST /panel/api/rcon/exec y
// GET /panel/api/rcon/log.
import PanelLayout from '../../../layouts/PanelLayout.astro';
import adminData from '../../../data/admin.json';
---
<PanelLayout title="Consola RCON" slug="rcon">
  <button slot="actions" id="refresh" type="button" class="pnl-btn">↻ Actualizar</button>

  <p class="pnl-meta">Ejecuta comandos de administración en el servidor en vivo. Cada acción queda registrada.</p>

  <div class="rcon-grid">
    <aside class="browser">
      <input id="cmd-search" type="search" placeholder="Buscar entre 138 comandos…" autocomplete="off" />
      <div id="cmd-list" class="cmd-list"></div>
    </aside>
    <div class="runner-col">
      <div id="runner" class="runner empty"><p class="muted">← Elige un comando.</p></div>

      <div class="term">
        <div class="term-bar"><span class="term-dot"></span><span class="term-title">salida</span><button id="term-clear" type="button">limpiar</button></div>
        <pre id="term-out" class="term-out" aria-live="polite"></pre>
      </div>

      <details id="history" class="history">
        <summary>Historial reciente</summary>
        <div id="hist-list" class="hist-list"></div>
      </details>
    </div>
  </div>

  <script type="application/json" id="cmd-data" set:html={JSON.stringify(adminData)}></script>

  <script>
    import { esc, fmtTime, nowTime, requireAdmin } from '../../../scripts/panel.ts';
    const DATA = JSON.parse(document.getElementById('cmd-data')!.textContent || '[]');
    const API = '/panel/api';
    const TIER_LABEL = { safe: 'Seguro', warn: 'Sensible', danger: 'Peligroso' };

    function tier(c) {
      const v = c.verb || '';
      if (c.level === 'SuperAdmin' || /Ban|Kick|Destroy|Delete|Shutdown|Reset|Wipe|Restart|Purge|Remove/i.test(v)) return 'danger';
      if (/Spawn|Teleport|^Tp|Give|^Add|^Set|Change|Cook|Heal|^Kill|Mute|Announce|Start|Force|Lock|Unlock|Promote|Demote|Fake|Vote/i.test(v)) return 'warn';
      return 'safe';
    }

    let current = null;

    function renderList(q) {
      q = (q || '').toLowerCase().trim();
      const groups = { safe: [], warn: [], danger: [] };
      for (const c of DATA) {
        if (q && !(c.verb.toLowerCase().includes(q) || (c.description || '').toLowerCase().includes(q))) continue;
        groups[tier(c)].push(c);
      }
      const list = document.getElementById('cmd-list');
      list.innerHTML = '';
      for (const t of ['safe', 'warn', 'danger']) {
        const cmds = groups[t].sort((a, b) => a.verb.localeCompare(b.verb));
        if (!cmds.length) continue;
        const grp = document.createElement('div');
        grp.className = 'grp grp-' + t;
        grp.innerHTML = `<div class="grp-h"><span class="dot ${t === 'safe' ? 'g' : t === 'warn' ? 'u' : 'r'}"></span>${TIER_LABEL[t]}<span class="n">${cmds.length}</span></div>`;
        for (const c of cmds) {
          const b = document.createElement('button');
          b.type = 'button'; b.className = 'cmd'; b.textContent = c.verb;
          b.addEventListener('click', () => { selectCmd(c); document.querySelectorAll('.cmd.on').forEach(x => x.classList.remove('on')); b.classList.add('on'); });
          grp.appendChild(b);
        }
        list.appendChild(grp);
      }
    }

    function selectCmd(c) {
      current = c;
      const t = tier(c);
      const args = c.args || [];
      const inputs = args.map((a, i) => `
        <label class="arg">
          <span class="arg-n">${esc(a.name) || 'arg' + (i + 1)} <em>${esc(a.type)}</em></span>
          <input class="arg-in" data-i="${i}" type="text" placeholder="${esc(a.description)}" />
        </label>`).join('');
      const danger = t === 'danger';
      const r = document.getElementById('runner');
      r.className = 'runner tier-' + t;
      r.innerHTML = `
        <div class="run-head">
          <h2>${esc(c.verb)}</h2>
          <span class="bdg ${t === 'safe' ? 'ok' : t === 'warn' ? 'warn' : 'danger'}">${TIER_LABEL[t]}</span>
          <span class="bdg lvl">${esc(c.level)}</span>
        </div>
        <p class="run-desc">${esc(c.description) || '<em>Sin descripción.</em>'}</p>
        ${args.length ? `<div class="args">${inputs}</div>` : '<p class="noargs">Sin argumentos.</p>'}
        <div class="preview"><code id="cmd-preview"></code></div>
        ${danger ? `<label class="confirm">Escribe <b>${esc(c.verb)}</b> para confirmar<input id="confirm-in" type="text" autocomplete="off" spellcheck="false" /></label>` : ''}
        <button id="run-btn" class="pnl-btn ${danger ? 'danger' : 'primary'}" type="button">Ejecutar${danger ? ' ⚠' : ''}</button>
      `;
      const ins = [...r.querySelectorAll('.arg-in')];
      const preview = r.querySelector('#cmd-preview');
      const update = () => { preview.textContent = '#' + buildCmd(ins); };
      ins.forEach((i) => i.addEventListener('input', update));
      update();
      r.querySelector('#run-btn').addEventListener('click', () => run(c, t, ins, r.querySelector('#confirm-in')));
    }

    function buildCmd(ins) {
      const args = ins.map((i) => i.value.trim()).filter(Boolean).join(' ');
      return (current.verb + ' ' + args).trim();
    }

    async function run(c, t, ins, cin) {
      if (t === 'danger' && (!cin || cin.value.trim() !== c.verb)) { out('⚠ Escribe el nombre del comando para confirmar.', true); return; }
      if (t === 'warn' && !confirm('¿Ejecutar "' + buildCmd(ins) + '" en el servidor?')) return;
      const args = ins.map((i) => i.value.trim()).filter(Boolean).join(' ');
      const btn = document.getElementById('run-btn'); btn.disabled = true; const old = btn.textContent; btn.textContent = 'Ejecutando…';
      try {
        const res = await fetch(API + '/rcon/exec', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' }, body: JSON.stringify({ verb: c.verb, args }) });
        const j = await res.json();
        if (res.ok) out('# ' + j.command + '\n' + (j.result || '(sin salida)'));
        else out('✖ ' + (j.error || res.status) + (j.detail ? ': ' + j.detail : ''), true);
      } catch (e) { out('✖ error de red', true); }
      finally { btn.disabled = false; btn.textContent = old; loadHistory(); }
    }

    function out(text, isErr) {
      const pre = document.getElementById('term-out');
      pre.textContent = `[${nowTime()}] ${text}\n\n` + pre.textContent;
      pre.classList.toggle('err', !!isErr);
    }

    async function loadHistory() {
      const btn = document.getElementById('refresh'); btn.disabled = true;
      try {
        const res = await fetch(API + '/rcon/log');
        if (!res.ok) return;
        const j = await res.json();
        const el = document.getElementById('hist-list');
        el.innerHTML = (j.log || []).map((e) =>
          `<div class="hist"><time>${esc(fmtTime(e.ts * 1000))}</time><code>${esc(e.command)}</code><span class="hr">${esc((e.result || '').slice(0, 90))}</span></div>`
        ).join('') || '<p class="muted">Sin comandos aún.</p>';
      } catch (e) {}
      finally { btn.disabled = false; }
    }

    function load() {
      renderList('');
      loadHistory();
      document.getElementById('cmd-search').addEventListener('input', (e) => renderList((e.target as HTMLInputElement).value));
      document.getElementById('term-clear').addEventListener('click', () => { document.getElementById('term-out').textContent = ''; });
      document.getElementById('refresh').addEventListener('click', loadHistory);
    }

    requireAdmin(load);
  </script>

  <style>
    /* Layout único del navegador de comandos + runner (sin clase compartida). */
    .rcon-grid { display: grid; grid-template-columns: minmax(220px, 280px) 1fr; gap: 1.2rem; align-items: start; }
    @media (max-width: 760px) { .rcon-grid { grid-template-columns: 1fr; } }

    /* navegador de comandos */
    .browser { position: sticky; top: 1rem; }
    #cmd-search { width: 100%; padding: 0.55rem 0.75rem; font-family: var(--font-mono); font-size: 0.85rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-paper); color: var(--c-ink); }
    #cmd-search:focus { outline: none; border-color: var(--c-rust); }
    .cmd-list { margin-top: 0.8rem; max-height: 68vh; overflow-y: auto; }
    .grp { margin-bottom: 0.9rem; }
    .grp-h { display: flex; align-items: center; gap: 0.4rem; font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.72rem; color: var(--c-ink-muted); margin-bottom: 0.3rem; }
    .grp-h .n { margin-left: auto; opacity: 0.6; }
    .cmd { display: block; width: 100%; text-align: left; padding: 0.3rem 0.5rem; font-family: var(--font-mono); font-size: 0.82rem; border: 0; background: none; color: var(--c-ink-soft); border-radius: 4px; cursor: pointer; }
    .cmd:hover { background: var(--c-paper-soft); color: var(--c-ink); }
    .cmd.on { background: var(--c-rust); color: #fff; }

    /* runner */
    .runner { background: var(--c-paper); border: 1px solid var(--c-rule); border-radius: var(--radius-lg); padding: 1.2rem 1.3rem; box-shadow: var(--shadow-card); border-top: 3px solid var(--c-rule); }
    .runner.tier-safe { border-top-color: var(--c-olive); }
    .runner.tier-warn { border-top-color: var(--c-rust); }
    .runner.tier-danger { border-top-color: #b3261e; }
    .runner.empty { display: grid; place-items: center; min-height: 120px; }
    .run-head { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .run-head h2 { margin: 0; font-family: var(--font-mono); font-weight: 700; font-size: 1.05rem; }
    .run-desc { color: var(--c-ink-soft); font-size: 0.92rem; margin: 0.5rem 0 0.9rem; }
    .args { display: grid; gap: 0.6rem; margin-bottom: 0.9rem; }
    .arg { display: grid; gap: 0.2rem; }
    .arg-n { font-family: var(--font-mono); font-size: 0.78rem; color: var(--c-ink); }
    .arg-n em { color: var(--c-ink-muted); font-style: normal; }
    .arg-in { padding: 0.45rem 0.6rem; font-family: var(--font-mono); font-size: 0.82rem; border: 1px solid var(--c-rule); border-radius: 4px; background: var(--c-paper); color: var(--c-ink); }
    .arg-in:focus { outline: none; border-color: var(--c-rust); }
    .noargs { color: var(--c-ink-muted); font-size: 0.85rem; margin: 0 0 0.9rem; }
    .preview { background: var(--c-bg-deep); border-radius: var(--radius); padding: 0.5rem 0.7rem; margin-bottom: 0.9rem; overflow-x: auto; }
    .preview code { font-family: var(--font-mono); font-size: 0.85rem; color: var(--c-bone); white-space: pre; }
    .confirm { display: grid; gap: 0.25rem; font-size: 0.82rem; color: #b3261e; margin-bottom: 0.8rem; }
    .confirm input { padding: 0.4rem 0.6rem; font-family: var(--font-mono); border: 1px solid #b3261e; border-radius: 4px; background: var(--c-paper); color: var(--c-ink); }

    /* terminal: separación bajo el runner (clases .term/.term-bar/.term-out son compartidas) */
    .term { margin-top: 1.1rem; }

    /* historial */
    .history { margin-top: 1.1rem; border-top: 1px dashed var(--c-rule); padding-top: 0.6rem; }
    .history summary { cursor: pointer; font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.78rem; color: var(--c-ink-muted); }
    .hist-list { margin-top: 0.6rem; display: grid; gap: 0.35rem; }
    .hist { display: grid; grid-template-columns: auto 1fr; gap: 0.2rem 0.7rem; font-family: var(--font-mono); font-size: 0.76rem; padding-bottom: 0.3rem; border-bottom: 1px solid var(--c-rule); }
    .hist time { color: var(--c-ink-muted); }
    .hist code { color: var(--c-ink); }
    .hist .hr { grid-column: 2; color: var(--c-ink-soft); }
  </style>
</PanelLayout>
