---
// Dashboard de fauna: animales / criaturas / puppets spawneados en el mundo.
// Lee /panel/api/fauna, que consulta global_encounter_manager_rogue_characters
// (los AI persistidos: animales, puppets, NPCs rogue) con su clase y coords.
// Usa el sistema compartido (PanelLayout + panel.css + scripts/panel.ts).
// OJO: estos actores son TRANSITORIOS (spawnean cerca de jugadores y despawnean
// por tiempo de vida), así que es normal que no haya ninguno persistido ahora.
import PanelLayout from '../../../layouts/PanelLayout.astro';
---
<PanelLayout title="Fauna" slug="fauna">
  <button slot="actions" id="refresh" type="button" class="pnl-btn">↻ Actualizar</button>

  <p id="meta" class="pnl-meta"></p>

  <div class="kpis" id="kpis"></div>

  <div class="cols two">
    <div class="block">
      <h2>Por tipo <span class="muted" id="kinds-n"></span></h2>
      <ul class="bars" id="kinds"></ul>
    </div>
    <div class="block">
      <h2>Ubicaciones <span class="muted" id="locs-n"></span></h2>
      <div class="dt-scroll">
        <table class="dt">
          <thead><tr><th>Criatura</th><th>Clase</th><th>Coords (mapa)</th><th>Despawn</th></tr></thead>
          <tbody id="rows"></tbody>
        </table>
      </div>
      <p class="pnl-hint" id="locs-hint"></p>
    </div>
  </div>

  <p class="pnl-hint">
    La fauna (animales, puppets y NPCs rogue) son actores de IA transitorios:
    aparecen alrededor de los jugadores activos y desaparecen por tiempo de vida.
    Solo se listan los que el servidor tiene persistidos en este instante.
  </p>

  <script>
    import { esc, nf, nowTime, requireAdmin } from '../../../scripts/panel.ts';
    const API = '/panel/api';

    // Embellecedor de clase de SCUM: BP_Animal_Deer_C -> "Deer", BP_Prisoner_... -> "Prisoner".
    const pretty = (c) => esc(
      String(c || '')
        .split(':').pop()
        .replace(/_ES$/, '')
        .replace(/^BP[CW]?_/, '')
        .replace(/_C$/, '')
        .replace(/^(Animal|Character|Creature)_/i, '')
        .replace(/_/g, ' ')
        .replace(/([a-z])([A-Z])/g, '$1 $2')
        .trim() || '?'
    );

    const fmtRem = (s) => {
      if (s == null) return '<span class="muted">—</span>';
      if (s <= 0) return '<span class="bdg warn">inminente</span>';
      const m = Math.round(s / 60);
      return m >= 1 ? `<span class="num">${m}</span> <span class="muted">min</span>` : `<span class="num">${Math.round(s)}</span> <span class="muted">s</span>`;
    };

    function render(d) {
      const kinds = d.kinds || [];
      const list = d.fauna || [];
      const max = kinds.reduce((a, k) => Math.max(a, k.n || 0), 0) || 1;

      // KPIs
      document.getElementById('kpis').innerHTML = `
        <div class="kpi"><span class="kv">${nf.format(d.total || 0)}</span><span class="kl">Criaturas</span><span class="ks">persistidas ahora</span></div>
        <div class="kpi"><span class="kv">${nf.format(kinds.length)}</span><span class="kl">Tipos</span><span class="ks">clases distintas</span></div>
        <div class="kpi"><span class="kv">${nf.format(d.with_coords || 0)}</span><span class="kl">Ubicadas</span><span class="ks">con coordenadas</span></div>`;

      // Recuento por tipo (barras)
      document.getElementById('kinds-n').textContent = kinds.length ? String(kinds.length) : '';
      document.getElementById('kinds').innerHTML = kinds.length
        ? kinds.map((k) => `<li>
            <span class="bn">${pretty(k.class)}</span>
            <span class="bb"><i style="width:${Math.round((k.n / max) * 100)}%"></i></span>
            <span class="bs">${nf.format(k.n)}</span>
          </li>`).join('')
        : '<li class="muted">Ninguna criatura spawneada ahora mismo.</li>';

      // Ubicaciones (tabla)
      document.getElementById('locs-n').textContent = list.length ? String(list.length) : '';
      document.getElementById('rows').innerHTML = list.length
        ? list.map((a) => {
            const coords = (a.px != null && a.py != null)
              ? `<span class="mono">${a.px}, ${a.py}</span>`
              : '<span class="muted">—</span>';
            return `<tr>
              <td><span class="name">${pretty(a.class)}</span></td>
              <td class="sid">${esc(a.class)}</td>
              <td>${coords}</td>
              <td>${fmtRem(a.despawn_remaining)}</td>
            </tr>`;
          }).join('')
        : '<tr><td colspan="4" class="muted">Sin ubicaciones que mostrar.</td></tr>';
      document.getElementById('locs-hint').textContent = d.with_coords
        ? 'Coordenadas reproyectadas a píxeles del mapa (0–2048).'
        : '';
    }

    async function load() {
      const btn = document.getElementById('refresh'); btn.disabled = true;
      try {
        const res = await fetch(API + '/fauna');
        if (!res.ok) { document.getElementById('meta').textContent = 'No se pudo cargar (' + res.status + ').'; return; }
        const d = await res.json();
        render(d);
        const tot = d.total || 0;
        document.getElementById('meta').textContent = tot
          ? `${tot} criaturas · ${(d.kinds || []).length} tipos · actualizado ${nowTime()}`
          : `Sin fauna persistida · actualizado ${nowTime()}`;
      } catch (e) {
        document.getElementById('meta').textContent = 'Error al cargar.';
      } finally {
        btn.disabled = false;
      }
    }

    document.getElementById('refresh').addEventListener('click', load);
    requireAdmin(load);
  </script>
</PanelLayout>
