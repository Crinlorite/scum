---
// Hub del panel admin (centro de control). Estilo compartido (panel.css). Oculta
// las herramientas admin-only a los no-admin (el backend las gatea igual).
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/panel.css';
const tools = [
  { href: '/panel/mapa', ico: '◎', title: 'Mapa en vivo', desc: 'Vuestra posición sobre el mapa de la isla, en tiempo real.', admin: false },
  { href: '/panel/jugadores', ico: 'JG', title: 'Jugadores', desc: 'Vivo/muerto, fama, dinero, escuadrón, conexión + inspector de skills e inventario.', admin: true },
  { href: '/panel/economia', ico: '€', title: 'Economía', desc: 'Traders y fondos, outposts (cash/oro) y existencias del mercado.', admin: true },
  { href: '/panel/squads', ico: 'SQ', title: 'Escuadrones', desc: 'Escuadrones del servidor, score y miembros por rango.', admin: true },
  { href: '/panel/overview', ico: 'OV', title: 'Overview', desc: 'Online, próximo reinicio, uptime del server y RAM del host.', admin: true },
  { href: '/panel/actividad', ico: 'AC', title: 'Actividad', desc: 'Feed de conexiones, desconexiones y muertes.', admin: true },
  { href: '/panel/vehiculos', ico: 'VH', title: 'Vehículos', desc: 'Inventario de vehículos del servidor: tipo, estado funcional, combustible, salud por pieza y ubicación en el mapa.', admin: true },
  { href: '/panel/bases', ico: 'BS', title: 'Bases y banderas', desc: 'Bases construidas con su dueño/escuadrón, bandera, número de elementos, integridad y estado de raid. Coordenadas X/Y para el mapa.', admin: true },
  { href: '/panel/bancos', ico: 'BN', title: 'Bancos', desc: 'Cuentas bancarias por jugador con saldos de dinero y oro, y totales en circulación.', admin: true },
  { href: '/panel/muertes', ico: 'MT', title: 'Muertes', desc: 'Estado de muerte por jugador: quién está muerto ahora y cuándo murió cada uno por última vez (España).', admin: true },
  { href: '/panel/rankings', ico: 'RK', title: 'Rankings', desc: 'Clasificaciones del servidor: top por fama, por niveles de skill (suma y media) y el mejor jugador de cada habilidad.', admin: true },
  { href: '/panel/cultivos', ico: 'CU', title: 'Cultivos', desc: 'Huertos del servidor: qué hay plantado, dónde, especie, crecimiento y plagas/enfermedades.', admin: true },
  { href: '/panel/bunkers', ico: 'BK', title: 'Búnkers', desc: 'Búnkers abandonados con su estado (activo/sellado), cuenta atrás de reactivación y ubicación en el mapa, más el registro de cerraduras de KillBoxes y plantas de búnker.', admin: true },
  { href: '/panel/fauna', ico: 'FA', title: 'Fauna', desc: 'Animales, puppets y NPCs rogue spawneados en el mundo: recuento por tipo y ubicaciones en el mapa.', admin: true },
  { href: '/panel/historico', ico: 'HI', title: 'Histórico', desc: 'Feed temporal reconstruido de los logs del servidor: comercio con traders, movimientos de banco, premios de fama y comandos de admin. Lo que la base de datos no guarda.', admin: true },
  { href: '/panel/killfeed', ico: 'KF', title: 'Killfeed', desc: 'Muertes registradas: víctima, asesino (NPC/PvP), arma y distancia (del kill log).', admin: true },
  { href: '/panel/chat', ico: 'CH', title: 'Chat', desc: 'Mensajes del chat del servidor (Local, Squad, Global) con su autor y hora.', admin: true },
  { href: '/panel/rcon', ico: '>_', title: 'Consola RCON', desc: 'Ejecuta comandos de administración en el servidor en vivo.', admin: true },
];
---
<BaseLayout lang="es" title="Panel del servidor" description="Centro de control del servidor" noindex>
  <section class="pnl">
    <div class="container">
      <div class="pnl-top"><div><span class="eyebrow">Privado</span><h1>Centro de control</h1></div></div>
      <p id="who" class="pnl-meta">Zona protegida — no aparece en la wiki pública.</p>
      <div class="hub">
        {tools.map((t) => (
          <a class="hubcard" href={t.href} data-admin={t.admin ? 'true' : undefined}>
            <span class="hc-ico">{t.ico}</span>
            <span>
              <span class="hc-t">{t.title}{t.admin && <span class="bdg lvl">admin</span>}</span>
              <span class="hc-d">{t.desc}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script>
    import { me } from '../../scripts/panel.ts';
    me.then((m) => {
      const who = document.getElementById('who');
      if (m && who) who.textContent = `Conectado como ${m.username || m.discord_id}${m.is_admin ? ' · administrador' : ' · moderador'}`;
      if (!m || !m.is_admin) document.querySelectorAll('[data-admin]').forEach((el) => el.remove());
    });
  </script>
</BaseLayout>
