---
// Dashboard de escuadrones (panel admin). Lee /panel/api/squads (backend host,
// RO sobre la DB viva, admin-only). Lista cada squad con su score y miembros/rangos.
// Usa el sistema compartido (PanelLayout + panel.css + scripts/panel.ts).
import PanelLayout from '../../../layouts/PanelLayout.astro';
---
<PanelLayout title="Escuadrones" slug="squads">
  <button slot="actions" id="refresh" type="button" class="pnl-btn">↻ Actualizar</button>

  <p id="meta" class="pnl-meta"></p>
  <div id="grid" class="cols two"></div>
  <p id="empty" class="pnl-hint" hidden>No hay escuadrones en el servidor.</p>
  <p class="pnl-hint">Clic en un escuadrón para ver su información completa.</p>

  <div id="modal" class="pnl-modal" hidden>
    <div class="pnl-modal-back" data-close></div>
    <div class="pnl-modal-card" role="dialog" aria-modal="true">
      <button class="pnl-modal-x" data-close aria-label="Cerrar">✕</button>
      <div id="modal-body"></div>
    </div>
  </div>

  <script>
    import { esc, nf, fmtRel, nowTime, requireAdmin } from '../../../scripts/panel.ts';
    const API = '/panel/api';
    let SQUADS = [];

    const memberRow = (m) =>
      `<tr><td><span class="name">${esc(m.name) || '—'}</span>${m.rank >= 4 ? ' <span class="bdg warn">líder</span>' : ''}</td>
        <td><span class="bdg lvl">${esc(m.rank_name)}</span></td>
        <td class="num">${m.fame != null ? Math.round(m.fame) : '—'}</td></tr>`;

    function membersTable(sq) {
      const rows = (sq.members || []).map(memberRow).join('') ||
        '<tr><td colspan="3" class="muted">Sin miembros.</td></tr>';
      return `<div class="dt-scroll"><table class="dt"><thead><tr><th>Miembro</th><th>Rango</th><th>Fama</th></tr></thead><tbody>${rows}</tbody></table></div>`;
    }

    function render(squads) {
      const grid = document.getElementById('grid');
      grid.innerHTML = squads.map((sq, idx) => {
        const cap = sq.member_limit ? `${sq.member_count}/${sq.member_limit}` : String(sq.member_count);
        return `<article class="block" data-idx="${idx}" tabindex="0" style="cursor:pointer">
          <h2>${esc(sq.name) || '—'} <span class="muted num">${sq.score != null ? nf.format(sq.score) : '—'} pts</span></h2>
          <p class="pnl-meta"><span class="bdg lvl">${cap} miembros</span> &nbsp; act. ${esc(fmtRel(sq.last_login))}</p>
          ${membersTable(sq)}
        </article>`;
      }).join('');
    }

    async function load() {
      const btn = document.getElementById('refresh'); btn.disabled = true;
      try {
        const j = await (await fetch(API + '/squads')).json();
        SQUADS = (j.squads || []).sort((a, b) => (b.score || 0) - (a.score || 0));
        render(SQUADS);
        document.getElementById('empty').hidden = SQUADS.length > 0;
        const totalMembers = SQUADS.reduce((n, s) => n + (s.member_count || 0), 0);
        document.getElementById('meta').textContent = `${SQUADS.length} escuadrones · ${totalMembers} miembros · actualizado ${nowTime()}`;
      } catch (e) { document.getElementById('meta').textContent = 'Error al cargar.'; }
      finally { btn.disabled = false; }
    }

    // --- detalle ---
    const modal = document.getElementById('modal');
    const closeModal = () => { modal.hidden = true; };
    modal.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeModal));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

    function detail(sq) {
      const body = document.getElementById('modal-body');
      const cap = sq.member_limit ? `${sq.member_count}/${sq.member_limit}` : String(sq.member_count);
      const info = sq.information
        ? `<div class="m-cols" style="grid-template-columns:1fr"><div><h3>Información</h3><p class="m-sub">${esc(sq.information).replace(/\r?\n/g, '<br>')}</p></div></div>`
        : '';
      body.innerHTML = `
        <h2 class="m-name">${esc(sq.name) || '—'} <span class="muted num">${sq.score != null ? nf.format(sq.score) : '—'} pts</span></h2>
        <p class="m-sub"><b class="mono">${cap}</b> miembros · última conexión ${esc(fmtRel(sq.last_login))} · última desconexión ${esc(fmtRel(sq.last_logout))}</p>
        ${info}
        ${membersTable(sq)}`;
      modal.hidden = false;
    }

    const grid = document.getElementById('grid');
    grid.addEventListener('click', (e) => { const c = (e.target as HTMLElement).closest('.block'); if (c) detail(SQUADS[+(c as HTMLElement).dataset.idx]); });
    grid.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') { const c = (e.target as HTMLElement).closest('.block'); if (c) detail(SQUADS[+(c as HTMLElement).dataset.idx]); } });
    document.getElementById('refresh').addEventListener('click', load);
    requireAdmin(load);
  </script>
</PanelLayout>
