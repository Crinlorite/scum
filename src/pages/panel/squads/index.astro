---
// Dashboard de escuadrones (panel admin). Lee /panel/api/squads (backend host,
// RO sobre la DB viva, admin-only). Lista cada squad con su score y miembros/rangos.
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout lang="es" title="Escuadrones" description="Dashboard de escuadrones del servidor" noindex>
  <section class="squads">
    <div class="container">
      <header class="ph">
        <div><span class="eyebrow">Panel · Admin</span><h1>Escuadrones</h1></div>
        <button id="refresh" type="button" class="refresh">↻ Actualizar</button>
      </header>

      <div id="gate" class="gate" hidden>
        <h2>Solo administradores</h2>
        <p>Este panel requiere permiso de administrador. Si eres moderador, tienes el <a href="/panel/mapa">mapa en vivo</a>.</p>
      </div>

      <div id="wrap" hidden>
        <p id="meta" class="meta"></p>
        <div id="grid" class="grid"></div>
        <p id="empty" class="tiphint" hidden>No hay escuadrones en el servidor.</p>
        <p class="tiphint">Clic en un escuadrón para ver su información completa.</p>
      </div>
    </div>
  </section>

  <!-- detalle -->
  <div id="modal" class="modal" hidden>
    <div class="modal-back" data-close></div>
    <div class="modal-card" role="dialog" aria-modal="true">
      <button class="modal-x" data-close aria-label="Cerrar">✕</button>
      <div id="modal-body"></div>
    </div>
  </div>

  <script>
    const API = '/panel/api';
    const esc = (s) => (s == null ? '' : String(s)).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
    const nf = new Intl.NumberFormat('es-ES');
    let SQUADS = [];

    function rel(iso) {
      if (!iso) return '—';
      const d = new Date(iso); if (isNaN(d)) return '—';
      const s = (Date.now() - d.getTime()) / 1000;
      if (s < 60) return 'hace segundos';
      if (s < 3600) return 'hace ' + Math.floor(s / 60) + ' min';
      if (s < 86400) return 'hace ' + Math.floor(s / 3600) + ' h';
      return 'hace ' + Math.floor(s / 86400) + ' d';
    }

    function memberLine(m) {
      const lead = m.rank >= 4 ? ' is-lead' : '';
      return `<li class="mem${lead}">
        <span class="m-name">${esc(m.name) || '—'}</span>
        <span class="m-rank">${esc(m.rank_name)}</span>
        <span class="m-fame">${m.fame != null ? Math.round(m.fame) : '—'}</span>
      </li>`;
    }

    function render(squads) {
      const grid = document.getElementById('grid');
      grid.innerHTML = squads.map((sq, idx) => {
        const cap = sq.member_limit ? `${sq.member_count}/${sq.member_limit}` : String(sq.member_count);
        const members = (sq.members || []).map(memberLine).join('') || '<li class="muted">Sin miembros.</li>';
        return `<article class="card" data-idx="${idx}" tabindex="0">
          <header class="c-head">
            <h2 class="c-name">${esc(sq.name) || '—'}</h2>
            <span class="c-score" title="Score del escuadrón">${sq.score != null ? nf.format(sq.score) : '—'}</span>
          </header>
          <p class="c-meta"><span class="chip">${cap} miembros</span><span class="muted">act. ${esc(rel(sq.last_login))}</span></p>
          <ul class="mems">${members}</ul>
        </article>`;
      }).join('');
    }

    async function load() {
      const btn = document.getElementById('refresh'); btn.disabled = true;
      try {
        const res = await fetch(API + '/squads');
        if (res.status === 403) { document.getElementById('gate').hidden = false; document.getElementById('wrap').hidden = true; return; }
        const j = await res.json();
        SQUADS = (j.squads || []).sort((a, b) => (b.score || 0) - (a.score || 0));
        render(SQUADS);
        document.getElementById('wrap').hidden = false;
        document.getElementById('empty').hidden = SQUADS.length > 0;
        const totalMembers = SQUADS.reduce((n, s) => n + (s.member_count || 0), 0);
        document.getElementById('meta').textContent = `${SQUADS.length} escuadrones · ${totalMembers} miembros · actualizado ${new Date().toLocaleTimeString()}`;
      } catch (e) { document.getElementById('meta').textContent = 'Error al cargar.'; }
      finally { btn.disabled = false; }
    }

    // --- detalle ---
    const modal = document.getElementById('modal');
    function closeModal() { modal.hidden = true; }
    modal.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeModal));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

    function detail(sq) {
      const body = document.getElementById('modal-body');
      const cap = sq.member_limit ? `${sq.member_count}/${sq.member_limit}` : String(sq.member_count);
      const members = (sq.members || []).map((m) =>
        `<li class="mem${m.rank >= 4 ? ' is-lead' : ''}"><span class="m-name">${esc(m.name) || '—'}</span><span class="m-rank">${esc(m.rank_name)}</span><span class="m-fame">${m.fame != null ? Math.round(m.fame) : '—'}</span></li>`).join('') || '<li class="muted">Sin miembros.</li>';
      const info = sq.information ? `<div class="m-info"><h3>Información</h3><p>${esc(sq.information).replace(/\r?\n/g, '<br>')}</p></div>` : '';
      body.innerHTML = `
        <h2 class="m-title">${esc(sq.name) || '—'} <span class="c-score">${sq.score != null ? nf.format(sq.score) : '—'}</span></h2>
        <p class="m-sub"><b>${cap}</b> miembros · última conexión ${esc(rel(sq.last_login))} · última desconexión ${esc(rel(sq.last_logout))}</p>
        ${info}
        <h3>Miembros <span class="muted">${sq.member_count || 0}</span></h3>
        <ul class="mems mems-full">${members}</ul>`;
      modal.hidden = false;
    }

    const grid = document.getElementById('grid');
    grid.addEventListener('click', (e) => { const c = e.target.closest('.card'); if (c) detail(SQUADS[+c.dataset.idx]); });
    grid.addEventListener('keydown', (e) => { if (e.key === 'Enter') { const c = e.target.closest('.card'); if (c) detail(SQUADS[+c.dataset.idx]); } });
    document.getElementById('refresh').addEventListener('click', load);
    load();
  </script>

  <style>
    .squads { padding: 2.5rem 0 4rem; }
    .ph { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 1.2rem; }
    .ph h1 { margin: 0.2rem 0 0; }
    .refresh { font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.78rem; padding: 0.4rem 0.9rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-paper); color: var(--c-ink-soft); cursor: pointer; }
    .refresh:hover { border-color: var(--c-rust); color: var(--c-ink); }
    .gate { background: var(--c-paper-soft); border: 1px solid var(--c-rule); border-left: 3px solid var(--c-rust); border-radius: var(--radius); padding: 1.5rem; }
    .gate h2 { margin: 0 0 0.4rem; font-family: var(--font-display); }
    .meta { color: var(--c-ink-muted); font-size: 0.82rem; font-family: var(--font-mono); margin: 0 0 0.9rem; }

    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 1rem; }
    .card { background: var(--c-paper); border: 1px solid var(--c-rule); border-radius: var(--radius-lg); padding: 1.1rem 1.2rem; cursor: pointer; transition: border-color 0.12s, box-shadow 0.12s; }
    .card:hover, .card:focus { border-color: var(--c-rust); outline: none; box-shadow: 0 6px 18px rgba(0,0,0,0.08); }
    .c-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.7rem; border-bottom: 1px solid var(--c-rule); padding-bottom: 0.5rem; margin-bottom: 0.6rem; }
    .c-name { margin: 0; font-family: var(--font-display); font-size: 1.15rem; }
    .c-score { font-family: var(--font-mono); font-size: 0.95rem; color: var(--c-rust); font-weight: 600; flex: none; }
    .c-meta { display: flex; align-items: center; gap: 0.6rem; margin: 0 0 0.7rem; }
    .chip { font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.66rem; padding: 0.12rem 0.5rem; border: 1px solid var(--c-rule); border-radius: 999px; color: var(--c-ink-soft); }
    .muted { color: var(--c-ink-muted); font-size: 0.8rem; }

    .mems { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
    .mem { display: grid; grid-template-columns: 1fr auto 2.6rem; align-items: center; gap: 0.5rem; font-size: 0.85rem; padding: 0.22rem 0; border-bottom: 1px dotted var(--c-rule); }
    .mem:last-child { border-bottom: 0; }
    .mem .m-name { font-weight: 600; font-family: var(--font-display); }
    .mem.is-lead .m-name::after { content: '★'; color: var(--c-rust); font-size: 0.7rem; margin-left: 0.3rem; vertical-align: top; }
    .m-rank { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--c-ink-muted); font-family: var(--font-display); }
    .mem.is-lead .m-rank { color: var(--c-rust); }
    .m-fame { font-family: var(--font-mono); text-align: right; color: var(--c-ink-soft); font-size: 0.8rem; }
    .tiphint { color: var(--c-ink-muted); font-size: 0.78rem; margin-top: 0.7rem; }

    /* detalle modal */
    .modal { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; padding: 1rem; }
    .modal[hidden] { display: none; }  /* el atributo hidden lo pisaba display:grid -> el modal bloqueaba la página */
    .modal-back { position: absolute; inset: 0; background: rgba(15,19,17,0.55); backdrop-filter: blur(2px); }
    .modal-card { position: relative; background: var(--c-paper); border-radius: var(--radius-lg); border: 1px solid var(--c-rule); max-width: 560px; width: 100%; max-height: 85vh; overflow-y: auto; padding: 1.6rem 1.7rem; box-shadow: 0 18px 50px rgba(0,0,0,0.3); }
    .modal-x { position: absolute; top: 0.8rem; right: 0.9rem; border: 0; background: none; font-size: 1.1rem; color: var(--c-ink-muted); cursor: pointer; }
    .modal-x:hover { color: var(--c-ink); }
    .m-title { margin: 0 0 0.2rem; font-family: var(--font-display); display: flex; align-items: baseline; gap: 0.6rem; }
    .m-sub { color: var(--c-ink-soft); margin: 0 0 1rem; font-size: 0.88rem; } .m-sub b { font-family: var(--font-mono); }
    .m-info { margin: 0 0 1.1rem; }
    .m-info h3, #modal-body > h3 { font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.78rem; color: var(--c-ink-muted); margin: 0 0 0.5rem; border-bottom: 1px solid var(--c-rule); padding-bottom: 0.3rem; }
    .m-info p { margin: 0; font-size: 0.88rem; color: var(--c-ink-soft); line-height: 1.5; }
    .mems-full .mem { font-size: 0.9rem; padding: 0.35rem 0; }
  </style>
</BaseLayout>