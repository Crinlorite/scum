---
// Overview del servidor (panel admin). Lee /panel/api/overview (backend host,
// admin-only): jugadores online (feed RAM o DB viva RO), proximo reinicio
// (systemd timer), uptime del contenedor SCUM y RAM del host. Usa el sistema
// compartido (PanelLayout + panel.css + scripts/panel.ts).
import PanelLayout from '../../../layouts/PanelLayout.astro';
---
<PanelLayout title="Overview" slug="overview">
  <button slot="actions" id="refresh" type="button" class="pnl-btn">↻ Actualizar</button>

  <p id="meta" class="pnl-meta"></p>

  <div class="kpis">
    <div class="kpi">
      <span id="online" class="kv">—</span>
      <span class="kl">Jugadores en línea</span>
      <span id="online-src" class="ks"></span>
    </div>
    <div class="kpi">
      <span id="restart-in" class="kv">—</span>
      <span class="kl">Próximo reinicio</span>
      <span id="restart-at" class="ks"></span>
    </div>
    <div class="kpi">
      <span id="up" class="kv">—</span>
      <span class="kl">Servidor SCUM</span>
      <span id="cinfo" class="ks"></span>
    </div>
    <div class="kpi">
      <span id="ram-used" class="kv">—</span>
      <span class="kl">RAM del host (GB)</span>
      <span id="ram-sub" class="ks"></span>
    </div>
  </div>

  <div class="cols two">
    <div class="block">
      <h2>En línea <span id="online-count" class="muted"></span></h2>
      <ul id="online-list" class="bars"></ul>
    </div>
    <div class="block">
      <h2>Recursos del host</h2>
      <ul id="res-bars" class="bars"></ul>
      <p id="cstart" class="pnl-hint"></p>
      <p id="swap-sub" class="pnl-hint"></p>
    </div>
  </div>

  <script>
    import { esc, nf, fmtDateTime, nowTime, requireAdmin } from '../../../scripts/panel.ts';
    const API = '/panel/api';
    let timer = null;

    // Duración legible (no es un reloj; las horas absolutas van por fmtDateTime).
    function dur(s) {
      if (s == null || s < 0) return '—';
      const d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
      if (d > 0) return d + 'd ' + h + 'h';
      if (h > 0) return h + 'h ' + m + 'm';
      return m + 'm';
    }
    // epoch en segundos -> hora de España (fmtDateTime espera ms/Date).
    const clock = (epoch) => (epoch ? fmtDateTime(epoch * 1000) : '');

    function paint(d) {
      const now = d.now || Math.floor(Date.now() / 1000);

      // online
      document.getElementById('online').textContent = d.online == null ? '—' : d.online;
      document.getElementById('online-src').textContent = d.online_source === 'ram' ? 'lectura en vivo (RAM)'
        : d.online_source === 'db' ? 'sesiones en la base de datos'
        : 'sin datos';
      document.getElementById('online-count').textContent = d.online == null ? '' : d.online;
      const lst = (d.players || []).map((p) => {
        const dead = p.alive === false ? ' <span class="bdg dead">muerto</span>' : ' <span class="bdg alive">vivo</span>';
        return `<li><span class="bn">${esc(p.name) || '—'}${dead}</span></li>`;
      }).join('') || '<li class="muted">Nadie conectado.</li>';
      document.getElementById('online-list').innerHTML = lst;

      // proximo reinicio
      const ri = document.getElementById('restart-in');
      if (d.next_restart) {
        const left = d.next_restart - now;
        ri.textContent = left > 0 ? 'en ' + dur(left) : 'inminente';
        document.getElementById('restart-at').textContent = clock(d.next_restart) + ' · 02:00 UTC';
      } else {
        ri.textContent = '—';
        document.getElementById('restart-at').textContent = 'timer no disponible';
      }

      // contenedor
      const c = d.container || {};
      document.getElementById('up').textContent = c.uptime_s != null ? dur(c.uptime_s) : '—';
      const cinfo = document.getElementById('cinfo');
      const state = `<span class="bdg ${c.status === 'running' ? 'ok' : 'bad'}">${esc(c.status) || '—'}</span>`;
      const health = c.health ? ` <span class="bdg ${c.health === 'healthy' ? 'ok' : 'warn'}">${esc(c.health)}</span>` : '';
      cinfo.innerHTML = state + health;
      document.getElementById('cstart').textContent = c.started_at != null
        ? 'Arrancado ' + clock(now - (c.uptime_s || 0)) : '';

      // RAM
      const r = d.ram || {};
      const bars = document.getElementById('res-bars');
      if (r.total_mb) {
        document.getElementById('ram-used').textContent = (r.used_mb / 1024).toFixed(1);
        const pct = r.used_pct != null ? r.used_pct : Math.round(r.used_mb * 100 / r.total_mb);
        document.getElementById('ram-sub').textContent =
          `${pct}% usado · ${(r.total_mb / 1024).toFixed(0)} GB · ${nf.format(r.available_mb)} MB libres`;
        const low = pct < 75 ? ' lowbar' : '';
        bars.innerHTML = `<li><span class="bn">RAM</span><span class="bb"><i class="${low}" style="width:${Math.min(100, pct)}%"></i></span><span class="bs">${pct}%</span></li>`;
        if (r.swap_total_mb) {
          const spct = Math.round((r.swap_used_mb || 0) * 100 / r.swap_total_mb);
          bars.innerHTML += `<li><span class="bn">Swap</span><span class="bb"><i class="lowbar" style="width:${Math.min(100, spct)}%"></i></span><span class="bs">${spct}%</span></li>`;
          document.getElementById('swap-sub').textContent =
            `Swap ${nf.format(r.swap_used_mb || 0)} / ${nf.format(r.swap_total_mb)} MB`;
        } else {
          document.getElementById('swap-sub').textContent = '';
        }
      } else {
        document.getElementById('ram-used').textContent = '—';
        document.getElementById('ram-sub').textContent = 'sin datos';
        bars.innerHTML = '<li class="muted">Sin datos de memoria.</li>';
        document.getElementById('swap-sub').textContent = '';
      }
    }

    async function load() {
      const btn = document.getElementById('refresh'); btn.disabled = true;
      try {
        const res = await fetch(API + '/overview');
        if (res.status === 403) {
          if (timer) { clearInterval(timer); timer = null; }
          document.getElementById('meta').textContent = 'Sin permiso.';
          return;
        }
        const d = await res.json();
        paint(d);
        document.getElementById('meta').textContent = 'Actualizado ' + nowTime();
      } catch (e) {
        document.getElementById('meta').textContent = 'Error al cargar.';
      } finally { btn.disabled = false; }
    }

    document.getElementById('refresh').addEventListener('click', load);
    requireAdmin(load);
    timer = setInterval(() => requireAdmin(load), 30000);  // auto-refresca cada 30 s
  </script>
</PanelLayout>
