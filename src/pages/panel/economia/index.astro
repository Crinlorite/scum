---
// Dashboard de economía (panel admin). Lee /panel/api/economy (backend host, RO
// sobre la DB viva, admin-only): traders y sus fondos/stock, outposts (cash+oro)
// y ranking de artículos por existencias. Usa el sistema compartido
// (PanelLayout + panel.css + scripts/panel.ts). Modelado en jugadores/index.astro.
import PanelLayout from '../../../layouts/PanelLayout.astro';
---
<PanelLayout title="Economía" slug="economia">
  <button slot="actions" id="refresh" type="button" class="pnl-btn">↻ Actualizar</button>

  <p id="meta" class="pnl-meta"></p>

  <div class="kpis" id="kpis"></div>

  <div class="cols two">
    <div class="block">
      <h2>Traders <span class="muted" id="ntraders"></span></h2>
      <div class="dt-scroll">
        <table class="dt">
          <thead><tr><th>Trader</th><th>Fondos</th><th>Artículos</th><th>Unidades</th><th>ID</th></tr></thead>
          <tbody id="rows-traders"></tbody>
        </table>
      </div>
      <p class="pnl-hint">Fondos = dinero del trader para comprarte cosas. Unidades = existencias reales (excluye el stock ilimitado del juego).</p>
    </div>

    <div class="block">
      <h2>Outposts <span class="muted" id="noutposts"></span></h2>
      <div class="dt-scroll">
        <table class="dt">
          <thead><tr><th>Outpost</th><th>Cash</th><th>Banco</th><th>Compra oro</th><th>Venta oro</th></tr></thead>
          <tbody id="rows-outposts"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="cols two">
    <div class="block">
      <h2>Más existencias</h2>
      <ul class="bars" id="top"></ul>
    </div>
    <div class="block">
      <h2>Menos existencias <span class="muted">en rotación</span></h2>
      <ul class="bars low" id="low"></ul>
    </div>
  </div>

  <script>
    import { esc, nf, nowTime, requireAdmin } from '../../../scripts/panel.ts';
    const API = '/panel/api';
    const money = (n) => (n == null ? '—' : nf.format(Math.round(n)));

    function kpi(label, value, sub) {
      return `<div class="kpi"><span class="kv">${value}</span><span class="kl">${esc(label)}</span>${sub ? `<span class="ks">${esc(sub)}</span>` : ''}</div>`;
    }

    function renderTraders(traders) {
      document.getElementById('rows-traders').innerHTML = traders.map((t) => {
        // 3 tramos de fondos = los 3 niveles de outpost; punto de color por nivel
        const tier = t.funds >= 11000 ? 'u' : t.funds >= 10100 ? 'g' : 's';
        const units = t.units ? nf.format(t.units) : '<span class="muted">—</span>';
        const om = t.omitted ? ` <span class="muted">(${t.omitted} fuera)</span>` : '';
        return `<tr>
          <td><span class="dot ${tier}"></span><span class="name">#${esc(t.id)}</span></td>
          <td class="num b"><b>${money(t.funds)}</b></td>
          <td>${esc(t.assets)}${om}</td>
          <td class="num">${units}</td>
          <td class="sid">${esc(t.runtime_id).slice(0, 8)}</td>
        </tr>`;
      }).join('');
    }

    function renderOutposts(outposts) {
      document.getElementById('rows-outposts').innerHTML = outposts.map((o) => `<tr>
        <td><span class="name">#${esc(o.id)}</span><br><span class="sid">${esc(o.runtime_id).slice(0, 8)}</span></td>
        <td class="num b"><b>${money(o.cash)}</b></td>
        <td class="num">${money(o.bank)}</td>
        <td class="num">${o.gold_buy != null ? nf.format(o.gold_buy) : '—'}</td>
        <td class="num">${o.gold_sell != null ? nf.format(o.gold_sell) : '—'}</td>
      </tr>`).join('');
    }

    function bars(elId, list, low) {
      const max = list.reduce((m, a) => Math.max(m, a.stock), 0) || 1;
      document.getElementById(elId).innerHTML = list.map((a) => `<li>
        <span class="bn">${esc(a.name)}</span>
        <span class="bb"><i${low ? ' class="lowbar"' : ''} style="width:${Math.max(2, (a.stock / max) * 100)}%"></i></span>
        <span class="bs">${nf.format(a.stock)}</span>
      </li>`).join('') || '<li class="muted">Sin datos.</li>';
    }

    async function load() {
      const btn = document.getElementById('refresh'); btn.disabled = true;
      try {
        const d = await (await fetch(API + '/economy')).json();
        const tt = d.totals || {};
        document.getElementById('kpis').innerHTML = [
          kpi('Fondos de traders', money(tt.funds), tt.traders + ' traders'),
          kpi('Outposts', nf.format(tt.outposts || 0), 'puntos de comercio'),
          kpi('Artículos en venta', nf.format(tt.tradeables || 0), 'líneas de stock'),
          kpi('Unidades en stock', nf.format(tt.units || 0), 'sin stock ilimitado'),
        ].join('');
        renderTraders(d.traders || []);
        renderOutposts(d.outposts || []);
        bars('top', d.top || [], false);
        bars('low', d.low || [], true);
        document.getElementById('ntraders').textContent = (d.traders || []).length;
        document.getElementById('noutposts').textContent = (d.outposts || []).length;
        document.getElementById('meta').textContent = `Actualizado ${nowTime()}`;
      } catch (e) {
        document.getElementById('meta').textContent = 'Error al cargar.';
      } finally {
        btn.disabled = false;
      }
    }

    document.getElementById('refresh').addEventListener('click', load);
    requireAdmin(load);
  </script>
</PanelLayout>
