---
import RecipesPage from '../../../components/RecipesPage.astro';
import { LANGUAGES, DEFAULT_LANG, type LangCode } from '../../../i18n/languages';

export function getStaticPaths() {
  return LANGUAGES.filter((l) => l.code !== DEFAULT_LANG).map((l) => ({ params: { lang: l.code } }));
}
const lang = Astro.params.lang as LangCode;
---
<RecipesPage lang={lang} />
