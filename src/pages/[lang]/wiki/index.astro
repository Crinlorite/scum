---
import WikiIndexPage from '../../../components/WikiIndexPage.astro';
import { LANGUAGES, DEFAULT_LANG, type LangCode } from '../../../i18n/languages';

export async function getStaticPaths() {
  return LANGUAGES
    .filter((l) => l.code !== DEFAULT_LANG)
    .map((l) => ({ params: { lang: l.code } }));
}

const lang = Astro.params.lang as LangCode;
---
<WikiIndexPage lang={lang} />
