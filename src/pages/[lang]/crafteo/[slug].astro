---
import RecipeDetailPage from '../../../components/RecipeDetailPage.astro';
import { CRAFTING } from '../../../data/craftrecipes';
import { LANGUAGES, DEFAULT_LANG, type LangCode } from '../../../i18n/languages';
export function getStaticPaths() {
  return LANGUAGES.filter((l) => l.code !== DEFAULT_LANG).flatMap((l) =>
    CRAFTING.map((r) => ({ params: { lang: l.code, slug: r.slug } })));
}
const lang = Astro.params.lang as LangCode;
const { slug } = Astro.params;
---
<RecipeDetailPage lang={lang} kind="crafting" slug={slug!} />
