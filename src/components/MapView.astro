---
// Interactive island map (Leaflet, CRS.Simple) over IslandMap.webp (2048²).
// POIs (poi.json) are grouped by sector into toggleable overlay layers, plus a
// sector-grid overlay. Pixel coords come straight from the export; y is flipped
// because Leaflet's CRS.Simple origin is bottom-left.
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';
import poiData from '../data/poi.json';
import type { LangCode } from '../i18n/languages';

interface Props { lang: LangCode; live?: boolean; noindex?: boolean; }
const { lang, live = false, noindex = false } = Astro.props;
const tr = useTranslations(lang);
const SIZE = 2048;
const pois = poiData as { n: string; s: string; t: string; x: number; y: number }[];
const sectorLabel = tr('map.sectors');
const gridLabel = tr('map.grid');
// POI type labels (localized) for the toggleable overlay filters.
const TYPE_META: Record<string, Partial<Record<LangCode, string>>> = {
  town: { es: 'Localidades', en: 'Settlements' },
  abandoned: { es: 'Ciudad abandonada', en: 'Abandoned city' },
  military: { es: 'Militar', en: 'Military' },
  farm: { es: 'Granjas', en: 'Farms' },
  industrial: { es: 'Industrial', en: 'Industrial' },
  nuclear: { es: 'Central nuclear', en: 'Nuclear plant' },
  rail: { es: 'Ferrocarril', en: 'Railway' },
  airfield: { es: 'Aeródromo', en: 'Airfield' },
  fortress: { es: 'Fortalezas / ruinas', en: 'Forts / ruins' },
  cabin: { es: 'Cabañas', en: 'Cabins' },
  gas: { es: 'Gasolineras', en: 'Gas stations' },
  zone: { es: 'Zonas seguras', en: 'Safe zones' },
  church: { es: 'Iglesias', en: 'Churches' },
};
const typeLabels = Object.fromEntries(Object.entries(TYPE_META).map(([k, v]) => [k, v[lang] ?? v.en ?? k]));
---
<BaseLayout lang={lang} title={tr('map.title')} description={tr('map.intro')} noindex={noindex}>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <section class="map-wrap">
    <div class="container container-prose">
      <span class="eyebrow">{tr('map.title')}</span>
      <h1>{tr('map.title')}</h1>
      <p class="intro">{tr('map.intro')} <span class="count">{pois.length} POIs</span></p>
    </div>
    <div id="scum-map" role="application" aria-label={tr('map.title')}></div>
  </section>

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline define:vars={{ pois, SIZE, sectorLabel, gridLabel, typeLabels, live }}>
    const L = window.L;
    const map = L.map('scum-map', { crs: L.CRS.Simple, minZoom: -2, maxZoom: 2, zoomSnap: 0.25, attributionControl: false });
    const bounds = [[0, 0], [SIZE, SIZE]];
    L.imageOverlay('/map/island.webp', bounds).addTo(map);
    map.fitBounds(bounds);

    // Imagen rotada 180° (el export venía contrapuesto). Píxel original (x,y) →
    // Leaflet. CALIB = corrección fija del residual del transform (px de pantalla).
    // Afinable en vivo con ?ox=..&oy=.. (sin redeploy) para calibrar y luego fijar.
    const CALIB = { x: -20, y: 0 };
    const params = new URLSearchParams(location.search);
    const OX = (parseFloat(params.get('ox')) || 0) + CALIB.x; // + derecha / − izquierda
    const OY = (parseFloat(params.get('oy')) || 0) + CALIB.y; // + arriba  / − abajo
    const flip = (x, y) => [y + OY, (SIZE - x) + OX];
    const COLORS = {
      town: '#9aa0a6', abandoned: '#b06a4a', military: '#c83a3a', farm: '#7cc56a',
      industrial: '#c9913a', nuclear: '#e0d24a', rail: '#8a8f96', airfield: '#5fb0d0',
      fortress: '#a06ad0', cabin: '#6a9a5a', gas: '#e0843f', zone: '#3fb950', church: '#d0c0a0',
    };

    // Group POIs by TYPE → one toggleable overlay per type (filter on/off).
    const byType = {};
    for (const p of pois) (byType[p.t] ??= []).push(p);
    const overlays = {};
    for (const key of Object.keys(byType).sort((a, b) => byType[b].length - byType[a].length)) {
      const grp = L.layerGroup();
      const col = COLORS[key] || '#9aa0a6';
      for (const p of byType[key]) {
        L.circleMarker(flip(p.x, p.y), { radius: 4, color: col, weight: 1, fillColor: col, fillOpacity: 0.7 })
          .bindPopup(`<b>${p.n}</b>${p.s ? `<br><small>${sectorLabel} ${p.s}</small>` : ''}`)
          .addTo(grp);
      }
      grp.addTo(map);
      overlays[`${typeLabels[key] || key} (${byType[key].length})`] = grp;
    }

    // Sector labels: la imagen ya trae la rejilla negra, así que solo etiquetamos
    // cada sector en el centro (mediana) de sus POIs → cae dentro de su celda real.
    const sectors = {};
    for (const p of pois) if (p.s) (sectors[p.s] ??= []).push(p);
    const median = (arr) => { const s = [...arr].sort((a, b) => a - b); return s[Math.floor(s.length / 2)]; };
    const grid = L.layerGroup();
    for (const key of Object.keys(sectors).sort()) {
      const ps = sectors[key];
      L.marker(flip(median(ps.map((p) => p.x)), median(ps.map((p) => p.y))), {
        interactive: false,
        icon: L.divIcon({ className: 'sector-label', html: key, iconSize: [30, 16] }),
      }).addTo(grid);
    }
    L.control.layers(null, { ...overlays, [gridLabel]: grid }, { collapsed: true }).addTo(map);

    // Live player positions (private panel only). The DB only refreshes on the
    // server autosave, so polling faster than that gains nothing — 5s is plenty.
    if (live) {
      const playerLayer = L.layerGroup().addTo(map);
      // "Actualizado hace Xs" — prueba visible de que sondea aunque el punto no se mueva.
      const status = L.control({ position: 'bottomleft' });
      status.onAdd = () => { const d = L.DomUtil.create('div', 'live-status'); d.textContent = '…'; return d; };
      status.addTo(map);
      let lastOk = 0, dataTs = 0, count = 0;
      const fmtAgo = (s) => (s < 60 ? `${s}s` : `${Math.floor(s / 60)} min`);
      const tick = () => {
        const el = document.querySelector('.live-status');
        if (!el) return;
        if (!lastOk) { el.textContent = '⏳ conectando…'; return; }
        const ago = Math.round((Date.now() - lastOk) / 1000);
        const dataAgo = dataTs ? Math.round(Date.now() / 1000 - dataTs) : null;
        el.innerHTML = `🟢 en vivo · consultado hace ${fmtAgo(ago)}` + (dataAgo != null ? ` · dato del servidor hace ${fmtAgo(dataAgo)}` : '');
      };
      const refresh = async () => {
        try {
          const r = await fetch('/panel/live/positions.json', { cache: 'no-store' });
          if (!r.ok) return;
          const data = await r.json();
          lastOk = Date.now(); dataTs = data.ts || 0; count++;
          playerLayer.clearLayers();
          for (const p of (data.players || [])) {
            const html = `<div class="pm-arrow" style="transform:rotate(${p.heading || 0}deg)">▲</div><span class="pm-name">${p.name}${p.alive ? '' : ' †'}</span>`;
            L.marker(flip(p.px, p.py), {
              icon: L.divIcon({ className: 'player-marker' + (p.alive ? '' : ' dead'), html, iconSize: [0, 0] }),
              zIndexOffset: 1000,
            }).addTo(playerLayer);
          }
          tick();
        } catch (e) { /* sin datos aún */ }
      };
      refresh();
      setInterval(refresh, 5000);
      setInterval(tick, 1000);
    }
  </script>
</BaseLayout>

<style>
  .map-wrap { padding: 2.5rem 0 0; }
  .intro { color: var(--c-ink-soft); font-size: 1.05rem; margin-bottom: 1.25rem; }
  .count { font-family: var(--font-mono); font-size: 0.82rem; color: var(--c-ink-muted); }
  #scum-map {
    width: 100%; height: calc(100vh - 220px); min-height: 460px;
    background: #0d1411; border-top: 1px solid var(--c-rule); border-bottom: 1px solid var(--c-rule);
  }
  /* Leaflet overrides for the dark map */
  :global(.leaflet-container) { background: #0d1411; font-family: inherit; }
  :global(.sector-label) {
    color: #e8e3d8; font-family: var(--font-mono); font-weight: 700; font-size: 0.8rem;
    text-shadow: 0 0 4px #000, 0 0 4px #000; pointer-events: none; text-align: center;
  }
  :global(.leaflet-popup-content) { font-size: 0.9rem; }
  :global(.leaflet-control-layers) { max-height: 70vh; overflow-y: auto; }
  :global(.player-marker) { position: relative; }
  :global(.player-marker .pm-arrow) { position: absolute; left: -8px; top: -8px; width: 16px; height: 16px; color: var(--c-rust-bright, #e0843f); font-size: 16px; line-height: 16px; text-align: center; text-shadow: 0 0 4px #000; }
  :global(.player-marker .pm-name) { position: absolute; left: 10px; top: -10px; white-space: nowrap; color: #fff; font-weight: 700; font-size: 0.8rem; text-shadow: 0 0 4px #000, 0 0 4px #000; }
  :global(.player-marker.dead .pm-arrow) { color: #c83a3a; }
  :global(.live-status) { background: rgba(13,20,17,0.85); color: #e8e3d8; font-size: 0.78rem; padding: 0.3rem 0.55rem; border-radius: 6px; border: 1px solid rgba(232,227,216,0.15); }

</style>
