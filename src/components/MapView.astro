---
// Interactive island map (Leaflet, CRS.Simple) over IslandMap.webp (2048²).
// POIs (poi.json) are grouped by sector into toggleable overlay layers, plus a
// sector-grid overlay. Pixel coords come straight from the export; y is flipped
// because Leaflet's CRS.Simple origin is bottom-left.
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';
import poiData from '../data/poi.json';
import type { LangCode } from '../i18n/languages';

interface Props { lang: LangCode; live?: boolean; noindex?: boolean; }
const { lang, live = false, noindex = false } = Astro.props;
const tr = useTranslations(lang);
const SIZE = 2048;
const pois = poiData as { n: string; s: string; t: string; x: number; y: number }[];
const sectorLabel = tr('map.sectors');
const gridLabel = tr('map.grid');
// POI type labels (localized) for the toggleable overlay filters.
const TYPE_META: Record<string, Partial<Record<LangCode, string>>> = {
  town: { es: 'Localidades', en: 'Settlements' },
  abandoned: { es: 'Ciudad abandonada', en: 'Abandoned city' },
  military: { es: 'Militar', en: 'Military' },
  farm: { es: 'Granjas', en: 'Farms' },
  industrial: { es: 'Industrial', en: 'Industrial' },
  nuclear: { es: 'Central nuclear', en: 'Nuclear plant' },
  rail: { es: 'Ferrocarril', en: 'Railway' },
  airfield: { es: 'Aeródromo', en: 'Airfield' },
  fortress: { es: 'Fortalezas / ruinas', en: 'Forts / ruins' },
  cabin: { es: 'Cabañas', en: 'Cabins' },
  gas: { es: 'Gasolineras', en: 'Gas stations' },
  zone: { es: 'Zonas seguras', en: 'Safe zones' },
  church: { es: 'Iglesias', en: 'Churches' },
};
const typeLabels = Object.fromEntries(Object.entries(TYPE_META).map(([k, v]) => [k, v[lang] ?? v.en ?? k]));
---
<BaseLayout lang={lang} title={tr('map.title')} description={tr('map.intro')} noindex={noindex}>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <section class="map-wrap">
    <div class="container container-prose">
      <span class="eyebrow">{tr('map.title')}</span>
      <h1>{tr('map.title')}</h1>
      <p class="intro">{tr('map.intro')} <span class="count">{pois.length} POIs</span></p>
    </div>
    <div id="scum-map" role="application" aria-label={tr('map.title')}></div>
  </section>

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline define:vars={{ pois, SIZE, sectorLabel, gridLabel, typeLabels, live }}>
    const L = window.L;
    const map = L.map('scum-map', { crs: L.CRS.Simple, minZoom: -2, maxZoom: 2, zoomSnap: 0.25, attributionControl: false });
    const bounds = [[0, 0], [SIZE, SIZE]];
    L.imageOverlay('/map/island.webp', bounds).addTo(map);
    map.fitBounds(bounds);

    // Pantalla completa, dos modos en escritorio:
    //  ⤢ rellena la VENTANA del navegador (CSS, mantienes pestaña/barra)
    //  ⛶ pantalla completa NATIVA del monitor (Fullscreen API)
    // En móvil/iOS la API nativa no va para divs → solo el modo ⤢ (que ya ocupa todo).
    const el = document.getElementById('scum-map');
    const isMobile = matchMedia('(max-width: 768px)').matches;
    const canNative = !!el.requestFullscreen && !isMobile;
    const inWindow = () => el.classList.contains('map-fullscreen');
    const setWindow = (on) => {
      el.classList.toggle('map-fullscreen', on);
      document.body.classList.toggle('map-fs-lock', on);
      const b = document.querySelector('.map-btn-win'); if (b) b.innerHTML = on ? '✕' : '⤢';
      setTimeout(() => map.invalidateSize(), 80);
    };
    const fs = L.control({ position: 'topleft' });
    fs.onAdd = () => {
      const box = L.DomUtil.create('div', 'leaflet-bar map-fs-box');
      const win = L.DomUtil.create('button', 'map-btn map-btn-win', box);
      win.type = 'button'; win.title = 'Rellenar la ventana del navegador'; win.innerHTML = '⤢';
      L.DomEvent.disableClickPropagation(win);
      L.DomEvent.on(win, 'click', (e) => { L.DomEvent.stop(e); setWindow(!inWindow()); });
      if (canNative) {
        const nat = L.DomUtil.create('button', 'map-btn map-btn-nat', box);
        nat.type = 'button'; nat.title = 'Pantalla completa del monitor'; nat.innerHTML = '⛶';
        L.DomEvent.disableClickPropagation(nat);
        L.DomEvent.on(nat, 'click', (e) => { L.DomEvent.stop(e); if (document.fullscreenElement === el) document.exitFullscreen(); else el.requestFullscreen(); });
      }
      return box;
    };
    fs.addTo(map);
    // Nativo: actualizar icono + reajustar al entrar/salir (Esc o botón del navegador).
    document.addEventListener('fullscreenchange', () => {
      const b = document.querySelector('.map-btn-nat'); if (b) b.innerHTML = document.fullscreenElement === el ? '✕' : '⛶';
      setTimeout(() => map.invalidateSize(), 80);
    });
    // Modo ventana (CSS): Esc lo cierra.
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && inWindow()) setWindow(false); });

    // Imagen rotada 180° (el export venía contrapuesto). Píxel original (x,y) →
    // Leaflet. CALIB = corrección fija del residual del transform (px de pantalla).
    // Afinable en vivo con ?ox=..&oy=.. (sin redeploy) para calibrar y luego fijar.
    const CALIB = { x: 0, y: -1 };
    const params = new URLSearchParams(location.search);
    const OX = (parseFloat(params.get('ox')) || 0) + CALIB.x; // + derecha / − izquierda
    const OY = (parseFloat(params.get('oy')) || 0) + CALIB.y; // + arriba  / − abajo
    const flip = (x, y) => [y + OY, (SIZE - x) + OX];
    const COLORS = {
      town: '#9aa0a6', abandoned: '#b06a4a', military: '#c83a3a', farm: '#7cc56a',
      industrial: '#c9913a', nuclear: '#e0d24a', rail: '#8a8f96', airfield: '#5fb0d0',
      fortress: '#a06ad0', cabin: '#6a9a5a', gas: '#e0843f', zone: '#3fb950', church: '#d0c0a0',
    };

    // Group POIs by TYPE → one toggleable overlay per type (filter on/off).
    const byType = {};
    for (const p of pois) (byType[p.t] ??= []).push(p);
    const overlays = {};
    const allMarkers = [];
    for (const key of Object.keys(byType).sort((a, b) => byType[b].length - byType[a].length)) {
      const grp = L.layerGroup();
      const col = COLORS[key] || '#9aa0a6';
      for (const p of byType[key]) {
        const mk = L.circleMarker(flip(p.x, p.y), { radius: 5, color: col, weight: 1, fillColor: col, fillOpacity: 0.75 })
          .bindPopup(`<b>${p.n}</b>${p.s ? `<br><small>${sectorLabel} ${p.s}</small>` : ''}`);
        mk.addTo(grp);
        allMarkers.push(mk);
      }
      grp.addTo(map);
      overlays[`${typeLabels[key] || key} (${byType[key].length})`] = grp;
    }
    // Los POI crecen al acercar (circleMarker es de píxel fijo) → clicables en móvil.
    const applyRadius = () => { const r = Math.round(5 + (map.getZoom() + 2) * 1.8); for (const mk of allMarkers) mk.setRadius(r); };
    map.on('zoomend', applyRadius);
    applyRadius();

    // Sector labels: la imagen ya trae la rejilla negra, así que solo etiquetamos
    // cada sector en el centro (mediana) de sus POIs → cae dentro de su celda real.
    const sectors = {};
    for (const p of pois) if (p.s) (sectors[p.s] ??= []).push(p);
    const grid = L.layerGroup();
    for (const key of Object.keys(sectors).sort()) {
      const ps = sectors[key];
      // Esquina superior-izquierda de la celda (tras rotar 180°) = flip(maxX, maxY);
      // iconAnchor [0,0] ancla la etiqueta por su esquina superior-izquierda ahí.
      const maxX = Math.max(...ps.map((p) => p.x)), maxY = Math.max(...ps.map((p) => p.y));
      L.marker(flip(maxX, maxY), {
        interactive: false,
        icon: L.divIcon({ className: 'sector-label', html: key, iconSize: [34, 16], iconAnchor: [-2, -2] }),
      }).addTo(grid);
    }
    L.control.layers(null, { ...overlays, [gridLabel]: grid }, { collapsed: true }).addTo(map);

    // Live player positions (private panel only). The DB only refreshes on the
    // server autosave, so polling faster than that gains nothing — 5s is plenty.
    if (live) {
      const playerLayer = L.layerGroup().addTo(map);
      // Marcadores persistentes por nombre: NO recrearlos en cada refresco, o la
      // animación del anillo se reinicia 4×/seg y parpadea. Solo movemos su posición.
      const markers = {};
      // Rumbo de AVANCE (no hacia dónde mira, sino hacia dónde va): se deriva del
      // desplazamiento entre muestras. travel[name] = {fx,fy: punto desde el que se
      // mide, deg: rumbo en pantalla, t: ts del último avance}. La flecha solo se
      // muestra mientras te mueves; quieto → solo círculo.
      const travel = {};
      // Fuente de posición: RAM Precise (grafo de Unreal, sin DB, exacta) / RAM (Old)
      // (híbrido DB+RAM) / DB (~17s).
      const SRC = {
        precise: { url: '/panel/live/positions-ram-precise.json', label: 'RAM Precise', tag: 'RAM Precise' },
        ram: { url: '/panel/live/positions-ram.json', label: 'RAM (Old)', tag: 'RAM (Old)' },
        db: { url: '/panel/live/positions.json', label: 'DB · ~17s', tag: 'DB' },
      };
      let source = localStorage.getItem('scum-map-src') || 'precise';
      if (!SRC[source]) source = 'precise';
      const srcCtl = L.control({ position: 'topright' });
      srcCtl.onAdd = () => { const d = L.DomUtil.create('div', 'src-ctl'); L.DomEvent.disableClickPropagation(d); return d; };
      srcCtl.addTo(map);
      const renderSrc = () => {
        const el = document.querySelector('.src-ctl'); if (!el) return;
        el.innerHTML = '<div class="me-h">Posición:</div>'
          + Object.entries(SRC).map(([k, v]) => `<button type="button" class="me-b${source === k ? ' on' : ''}" data-s="${k}">${v.label}</button>`).join('');
        el.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
          source = b.getAttribute('data-s'); localStorage.setItem('scum-map-src', source); renderSrc(); refresh();
        }));
      };
      // "Centrarme en …": declaras quién eres y el mapa te recentra en cada refresco.
      let players = [];
      let me = localStorage.getItem('scum-map-me') || '';
      let follow = !!me;
      const meCtl = L.control({ position: 'topright' });
      meCtl.onAdd = () => { const d = L.DomUtil.create('div', 'me-ctl'); L.DomEvent.disableClickPropagation(d); return d; };
      meCtl.addTo(map);
      const centerMe = (force) => {
        if (!follow || !me) return;
        const p = players.find((x) => x.name === me);
        if (p) map.setView(flip(p.px, p.py), force ? Math.max(map.getZoom(), 1) : map.getZoom(), { animate: true });
      };
      const renderMe = () => {
        const el = document.querySelector('.me-ctl'); if (!el) return;
        if (!players.length) { el.innerHTML = ''; return; }
        el.innerHTML = '<div class="me-h">Centrarme en:</div>'
          + players.map((p) => `<button type="button" class="me-b${p.name === me && follow ? ' on' : ''}" data-n="${p.name}">${p.name}</button>`).join('')
          + (follow && me ? '<button type="button" class="me-off">✕ dejar de seguir</button>' : '');
        el.querySelectorAll('.me-b').forEach((b) => b.addEventListener('click', () => {
          me = b.getAttribute('data-n'); follow = true; localStorage.setItem('scum-map-me', me); renderMe(); centerMe(true);
        }));
        const off = el.querySelector('.me-off');
        if (off) off.addEventListener('click', () => { follow = false; localStorage.removeItem('scum-map-me'); renderMe(); });
      };
      // "Actualizado hace Xs" — prueba visible de que sondea aunque el punto no se mueva.
      const status = L.control({ position: 'bottomleft' });
      status.onAdd = () => { const d = L.DomUtil.create('div', 'live-status'); d.textContent = '…'; return d; };
      status.addTo(map);
      let lastOk = 0, dataTs = 0, count = 0;
      const fmtAgo = (s) => (s < 60 ? `${s}s` : `${Math.floor(s / 60)} min`);
      const tick = () => {
        const el = document.querySelector('.live-status');
        if (!el) return;
        if (!lastOk) { el.textContent = '⏳ conectando…'; return; }
        const ago = Math.round((Date.now() - lastOk) / 1000);
        const dataAgo = dataTs ? Math.round(Date.now() / 1000 - dataTs) : null;
        el.innerHTML = `🟢 ${SRC[source].tag} · consultado hace ${fmtAgo(ago)}` + (dataAgo != null ? ` · dato hace ${fmtAgo(dataAgo)}` : '');
      };
      const refresh = async () => {
        try {
          const r = await fetch(SRC[source].url, { cache: 'no-store' });
          if (!r.ok) return;
          const data = await r.json();
          lastOk = Date.now(); dataTs = data.ts || 0; count++;
          for (const p of (data.players || [])) {
            const ll = flip(p.px, p.py);
            let mk = markers[p.name];
            if (!mk) {
              mk = L.marker(ll, {
                icon: L.divIcon({ className: 'player-marker', html: '<div class="pm-dot"></div><div class="pm-go hide"></div><span class="pm-name"></span>', iconSize: [0, 0] }),
                zIndexOffset: 1000,
              }).addTo(playerLayer);
              markers[p.name] = mk;
            } else {
              mk.setLatLng(ll);
            }
            // Rumbo de avance: acumula hasta moverte >~0.1 px de mapa (estable, sin
            // ruido) y calcula el ángulo en pantalla. flip() => latlng [py, SIZE-px],
            // así que en pantalla derecha = −dpx y arriba = +dpy.
            const tv = travel[p.name] || (travel[p.name] = { fx: p.px, fy: p.py, deg: null, t: 0 });
            if (Math.hypot(p.px - tv.fx, p.py - tv.fy) > 0.1) {
              tv.deg = Math.atan2(-(p.px - tv.fx), p.py - tv.fy) * 180 / Math.PI;
              tv.fx = p.px; tv.fy = p.py; tv.t = Date.now();
            }
            const moving = tv.deg != null && tv.t && (Date.now() - tv.t < 1500);
            const el = mk.getElement();
            if (el) {
              el.classList.toggle('dead', !p.alive);
              const nm = el.querySelector('.pm-name');
              if (nm) nm.textContent = p.name + (p.alive ? '' : ' †');
              const go = el.querySelector('.pm-go');
              if (go) {
                if (tv.deg != null) go.style.transform = 'rotate(' + tv.deg.toFixed(1) + 'deg)';
                go.classList.toggle('hide', !moving);
              }
            }
          }
          // Quitar marcadores de jugadores que ya no aparecen en el feed.
          const present = new Set((data.players || []).map((p) => p.name));
          for (const name of Object.keys(markers)) if (!present.has(name)) { playerLayer.removeLayer(markers[name]); delete markers[name]; }
          players = data.players || [];
          renderMe();
          centerMe(false);
          tick();
        } catch (e) { /* sin datos aún */ }
      };
      renderSrc();
      refresh();
      setInterval(refresh, 250);
      setInterval(tick, 1000);
    }
  </script>
</BaseLayout>

<style>
  .map-wrap { padding: 2.5rem 0 0; }
  .intro { color: var(--c-ink-soft); font-size: 1.05rem; margin-bottom: 1.25rem; }
  .count { font-family: var(--font-mono); font-size: 0.82rem; color: var(--c-ink-muted); }
  #scum-map {
    width: 100%; height: calc(100vh - 220px); min-height: 460px;
    background: #0d1411; border-top: 1px solid var(--c-rule); border-bottom: 1px solid var(--c-rule);
  }
  /* Leaflet overrides for the dark map */
  :global(.leaflet-container) { background: #0d1411; font-family: inherit; }
  :global(.sector-label) {
    color: #e8e3d8; font-family: var(--font-mono); font-weight: 700; font-size: 0.8rem;
    text-shadow: 0 0 4px #000, 0 0 4px #000; pointer-events: none; text-align: center;
  }
  :global(.leaflet-popup-content) { font-size: 0.9rem; }
  :global(.leaflet-control-layers) { max-height: 70vh; overflow-y: auto; }
  :global(.player-marker) { position: relative; }
  /* Marcador de jugador: círculo con borde blanco + anillo pulsante (sin dirección,
     el rumbo no es fiable). Destaca claramente de los POIs (puntos pequeños fijos). */
  :global(.player-marker .pm-dot) { position: absolute; left: -9px; top: -9px; width: 18px; height: 18px; border-radius: 50%; background: var(--c-rust-bright, #e0843f); border: 2px solid #fff; box-shadow: 0 0 7px 1px rgba(224,132,63,0.95), 0 0 0 1px #000; }
  :global(.player-marker .pm-dot)::after { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 2px solid var(--c-rust-bright, #e0843f); animation: pm-pulse 2.6s ease-in-out infinite; pointer-events: none; }
  @keyframes pm-pulse { 0% { transform: scale(0.85); opacity: 0.6; } 70% { opacity: 0; } 100% { transform: scale(1.9); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { :global(.player-marker .pm-dot)::after { animation: none; opacity: 0; } }
  /* Flecha de AVANCE: triángulo que orbita el círculo apuntando a dónde te mueves
     (transform-origin en el centro del marcador). Oculta cuando estás quieto. */
  :global(.player-marker .pm-go) { position: absolute; left: 0; top: 0; transform-origin: 0 0; transition: transform 0.2s linear; pointer-events: none; }
  :global(.player-marker .pm-go)::before { content: ''; position: absolute; left: -6px; top: -24px; width: 0; height: 0; border-left: 6px solid transparent; border-right: 6px solid transparent; border-bottom: 10px solid #fff; filter: drop-shadow(0 0 2px #000); }
  :global(.player-marker .pm-go.hide) { display: none; }
  :global(.player-marker.dead .pm-go)::before { border-bottom-color: #c83a3a; }
  :global(.player-marker .pm-name) { position: absolute; left: 13px; top: -10px; white-space: nowrap; color: #fff; font-weight: 700; font-size: 0.8rem; text-shadow: 0 0 4px #000, 0 0 4px #000; }
  :global(.player-marker.dead .pm-dot) { background: #c83a3a; box-shadow: 0 0 7px 1px rgba(200,58,58,0.95), 0 0 0 1px #000; }
  :global(.player-marker.dead .pm-dot)::after { border-color: #c83a3a; }
  :global(.live-status) { background: rgba(13,20,17,0.85); color: #e8e3d8; font-size: 0.78rem; padding: 0.3rem 0.55rem; border-radius: 6px; border: 1px solid rgba(232,227,216,0.15); }
  :global(#scum-map.map-fullscreen) { position: fixed; inset: 0; width: 100vw; height: 100vh; max-height: none; z-index: 9999; border: 0; }
  :global(#scum-map:fullscreen) { width: 100vw; height: 100vh; max-height: none; }
  :global(body.map-fs-lock) { overflow: hidden; }
  :global(.map-btn) { width: 34px; height: 34px; font-size: 18px; line-height: 1; cursor: pointer; background: #fff; color: #222; border: 2px solid rgba(0,0,0,0.2); border-radius: 4px; }
  :global(.map-btn:hover) { background: #f0f0f0; }
  :global(.me-ctl) { background: rgba(13,20,17,0.9); border: 1px solid rgba(232,227,216,0.15); border-radius: 6px; padding: 0.35rem; display: flex; flex-direction: column; gap: 0.25rem; max-width: 12rem; }
  :global(.me-ctl .me-h) { color: #b9c0b6; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; }
  :global(.me-ctl button) { cursor: pointer; font-size: 0.85rem; padding: 0.3rem 0.5rem; border-radius: 5px; border: 1px solid rgba(232,227,216,0.2); background: transparent; color: #e8e3d8; text-align: left; }
  :global(.me-ctl button:hover) { border-color: var(--c-rust); }
  :global(.me-ctl .me-b.on) { background: var(--c-rust); border-color: var(--c-rust); color: #fff; }
  :global(.me-ctl .me-off) { color: #c89; font-size: 0.78rem; }
  :global(.src-ctl) { background: rgba(13,20,17,0.9); border: 1px solid rgba(232,227,216,0.15); border-radius: 6px; padding: 0.35rem; display: flex; flex-direction: column; gap: 0.25rem; max-width: 12rem; margin-bottom: 0.4rem; }
  :global(.src-ctl .me-h) { color: #b9c0b6; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; }
  :global(.src-ctl button) { cursor: pointer; font-size: 0.85rem; padding: 0.3rem 0.5rem; border-radius: 5px; border: 1px solid rgba(232,227,216,0.2); background: transparent; color: #e8e3d8; text-align: left; }
  :global(.src-ctl button:hover) { border-color: var(--c-rust); }
  :global(.src-ctl .me-b.on) { background: var(--c-rust); border-color: var(--c-rust); color: #fff; }

</style>
