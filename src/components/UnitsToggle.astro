---
// Lets the visitor switch weight/distance between metric (g·kg·m) and
// imperial (oz·lb·yd), like SCUM in-game. Values are rendered metric by
// default (works without JS); this converts marked-up nodes client-side
// ([data-w] = grams, [data-d] = meters) and remembers the choice.
import { useTranslations } from '../i18n/utils';
import type { LangCode } from '../i18n/languages';
interface Props { lang: LangCode; }
const { lang } = Astro.props;
const tr = useTranslations(lang);
---
<button type="button" class="units-toggle" aria-label={tr('units.label')} title={tr('units.label')}>
  <span class="ut-label">kg</span>
</button>

<script>
  const KEY = 'scum-units';
  const btn = document.querySelector<HTMLButtonElement>('.units-toggle');
  if (btn) {
    const button = btn;
    const lab = button.querySelector<HTMLElement>('.ut-label')!;
    const lang = document.documentElement.lang || 'es';
    let units = localStorage.getItem(KEY) === 'imperial' ? 'imperial' : 'metric';
    const nf = (n: number, max = 2) => n.toLocaleString(lang, { maximumFractionDigits: max });

    function fmtWeight(g: number): string {
      if (units === 'imperial') {
        const oz = g / 28.3495;
        return oz < 16 ? `${Math.round(oz)} oz` : `${nf(oz / 16)} lb`;
      }
      return g < 1000 ? `${Math.round(g)} g` : `${nf(g / 1000)} kg`;
    }
    function fmtDist(m: number): string {
      return units === 'imperial' ? `${nf(m / 0.9144, 0)} yd` : `${nf(m, 0)} m`;
    }
    function apply() {
      lab.textContent = units === 'imperial' ? 'lb' : 'kg';
      button.setAttribute('aria-pressed', units === 'imperial' ? 'true' : 'false');
      document.querySelectorAll<HTMLElement>('[data-w]').forEach((el) => {
        const g = Number(el.dataset.w); if (!isNaN(g)) el.textContent = fmtWeight(g);
      });
      document.querySelectorAll<HTMLElement>('[data-d]').forEach((el) => {
        const m = Number(el.dataset.d); if (!isNaN(m)) el.textContent = fmtDist(m);
      });
    }
    button.addEventListener('click', () => {
      units = units === 'metric' ? 'imperial' : 'metric';
      localStorage.setItem(KEY, units);
      apply();
    });
    apply();
  }
</script>

<style>
  .units-toggle {
    display: inline-grid; place-items: center; min-width: 34px; height: 34px;
    padding: 0 0.5rem; color: var(--c-ash);
    background: transparent; border: 1px solid rgba(232, 227, 216, 0.12);
    border-radius: 6px; cursor: pointer;
    font-family: var(--font-display); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.04em;
    transition: color 120ms ease, border-color 120ms ease;
  }
  .units-toggle:hover { color: var(--c-bone); border-color: var(--c-rust); }
  .units-toggle[aria-pressed='true'] { color: var(--c-rust-bright); border-color: var(--c-rust); }
</style>
