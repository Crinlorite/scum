---
import { useTranslations, localizedPath } from '../i18n/utils';
import LangSwitcher from './LangSwitcher.astro';
import ItemSearch from './ItemSearch.astro';
import type { LangCode } from '../i18n/languages';

interface Props { lang: LangCode; }
const { lang } = Astro.props;
const tr = useTranslations(lang);
const here = Astro.url.pathname;
const home = localizedPath('/', lang);

function isActive(href: string): boolean {
  if (href.includes('#')) return false;
  if (href === home) return here === href;
  return here === href || here.startsWith(href + '/');
}
---
<header class="site-nav">
  <div class="container nav-inner">
    <a class="brand" href={home}>
      <span class="brand-mark" aria-hidden="true">SC</span>
      <span class="brand-name">{tr('site.name')}</span>
    </a>
    <nav id="primary-nav" aria-label="primary">
      <ul>
        <li><a href={home} class={isActive(home) ? 'active' : ''}>{tr('nav.home')}</a></li>
        <li><a href={localizedPath('/wiki', lang)} class={isActive(localizedPath('/wiki', lang)) ? 'active' : ''}>{tr('nav.wiki')}</a></li>
        <li><a href={localizedPath('/mapa', lang)} class={isActive(localizedPath('/mapa', lang)) ? 'active' : ''}>{tr('nav.map')}</a></li>
        <li><a href={`${home}#server`}>{tr('nav.server')}</a></li>
        <li><a href={`${home}#contribute`}>{tr('nav.contribute')}</a></li>
      </ul>
    </nav>
    <div class="nav-actions">
      <ItemSearch lang={lang} />
      <LangSwitcher lang={lang} />
      <button class="nav-toggle" aria-label={tr('nav.menu')} aria-expanded="false" aria-controls="primary-nav">
        <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<script>
  // Desktop: <details> acts as a click dropdown. Mobile: hamburger toggles the
  // whole nav panel, and the dropdown becomes a vertical accordion inside it.
  const header = document.querySelector<HTMLElement>('.site-nav');
  const nav = document.getElementById('primary-nav');
  const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
  const dd = document.querySelector<HTMLDetailsElement>('details.nav-dd');

  function setNav(open: boolean) {
    if (!nav || !toggle) return;
    nav.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('nav-locked', open);
  }
  toggle?.addEventListener('click', () => setNav(!nav?.classList.contains('open')));

  // Close the mobile panel when a real navigation link is tapped (not the accordion summary).
  nav?.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a');
    if (a) setNav(false);
  });

  document.addEventListener('click', (e) => {
    if (header && !header.contains(e.target as Node)) { setNav(false); if (dd) dd.open = false; }
  });
  document.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Escape') { setNav(false); if (dd) dd.open = false; }
  });
  // On desktop, clicking outside the dropdown closes it.
  document.addEventListener('click', (e) => {
    if (dd && dd.open && !dd.contains(e.target as Node)) dd.open = false;
  });
</script>

<style>
  .site-nav { background: var(--c-bg-deep); color: var(--c-bone); border-bottom: 1px solid rgba(232, 227, 216, 0.08); position: sticky; top: 0; z-index: 50; }
  .nav-inner { display: flex; align-items: center; gap: 1.25rem; min-height: 64px; }
  .brand { display: flex; align-items: center; gap: 0.6rem; color: var(--c-bone); text-decoration: none; font-family: var(--font-display); font-weight: 700; letter-spacing: 0.05em; }
  .brand-mark { display: inline-grid; place-items: center; width: 32px; height: 32px; border: 1px solid var(--c-rust); color: var(--c-rust-bright); border-radius: 4px; font-size: 0.8rem; }
  .brand-name { font-size: 1rem; text-transform: uppercase; }
  nav { margin-left: auto; }
  nav > ul { list-style: none; display: flex; align-items: center; gap: 1.25rem; padding: 0; margin: 0; }
  nav a { color: var(--c-ash); text-decoration: none; font-size: 0.95rem; padding: 0.25rem 0; border-bottom: 2px solid transparent; transition: color 120ms ease, border-color 120ms ease; }
  nav a:hover { color: var(--c-bone); }
  nav a.active { color: var(--c-bone); border-bottom-color: var(--c-rust); }

  .nav-actions { display: flex; align-items: center; gap: 0.6rem; }
  .nav-toggle { display: none; }

  .nav-dd-li { position: relative; }
  .nav-dd summary { list-style: none; cursor: pointer; color: var(--c-ash); font-size: 0.95rem; display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.25rem 0; border-bottom: 2px solid transparent; }
  .nav-dd summary::-webkit-details-marker { display: none; }
  .nav-dd summary:hover { color: var(--c-bone); }
  .nav-dd summary.active { color: var(--c-bone); border-bottom-color: var(--c-rust); }
  .ddc { font-size: 0.7rem; transition: transform 150ms ease; }
  .nav-dd[open] summary .ddc { transform: rotate(180deg); }
  .nav-dd-panel { position: absolute; top: calc(100% + 8px); left: 0; min-width: 12rem; display: grid; gap: 0.1rem; background: var(--c-bg-panel, #1a1f1c); border: 1px solid rgba(232, 227, 216, 0.12); border-radius: 8px; padding: 0.4rem; box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45); z-index: 60; }
  .nav-dd-panel a { padding: 0.4rem 0.6rem; border-radius: 5px; border-bottom: none; font-size: 0.9rem; }
  .nav-dd-panel a:hover { background: rgba(232, 227, 216, 0.06); }
  .nav-dd-panel a.active { color: var(--c-rust-bright); background: rgba(176, 74, 42, 0.14); }

  @media (max-width: 720px) {
    .nav-inner { gap: 0.75rem; min-height: 56px; }
    .brand { margin-right: auto; }
    .brand-name { display: none; }

    /* Hamburger button */
    .nav-toggle {
      display: inline-grid; place-items: center; width: 38px; height: 38px;
      background: transparent; border: 1px solid rgba(232, 227, 216, 0.15);
      border-radius: 6px; cursor: pointer; color: var(--c-bone);
    }
    .nav-toggle .bars { display: grid; gap: 4px; width: 18px; }
    .nav-toggle .bars span { height: 2px; width: 100%; background: currentColor; border-radius: 2px; transition: transform 160ms ease, opacity 160ms ease; }
    .nav-toggle[aria-expanded='true'] .bars span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
    .nav-toggle[aria-expanded='true'] .bars span:nth-child(2) { opacity: 0; }
    .nav-toggle[aria-expanded='true'] .bars span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

    /* Nav becomes a full-width dropdown panel toggled by the hamburger */
    nav#primary-nav {
      position: absolute; top: 100%; left: 0; right: 0; margin: 0;
      display: none; background: var(--c-bg-panel, #1a1f1c);
      border-top: 1px solid rgba(232, 227, 216, 0.1);
      box-shadow: 0 14px 28px rgba(0, 0, 0, 0.5);
      max-height: calc(100vh - 56px); overflow-y: auto; z-index: 55;
    }
    nav#primary-nav.open { display: block; }
    nav > ul { flex-direction: column; align-items: stretch; gap: 0; padding: 0.5rem; }
    nav > ul > li { width: 100%; }
    nav > ul > li > a {
      display: block; padding: 0.85rem 0.75rem; font-size: 1rem;
      border-bottom: 1px solid rgba(232, 227, 216, 0.06);
    }
    nav > ul > li:last-child > a { border-bottom: none; }

    /* "Datos del juego" → vertical accordion */
    .nav-dd-li { width: 100%; }
    .nav-dd summary {
      width: 100%; justify-content: space-between; font-size: 1rem;
      padding: 0.85rem 0.75rem; border-bottom: 1px solid rgba(232, 227, 216, 0.06);
    }
    .nav-dd-panel {
      position: static; box-shadow: none; border: none; border-radius: 0;
      min-width: 0; width: 100%; margin: 0; padding: 0.2rem 0 0.4rem;
      display: block; background: rgba(0, 0, 0, 0.22);
    }
    .nav-dd-panel a { display: block; padding: 0.6rem 0.75rem 0.6rem 1.5rem; font-size: 0.95rem; border-radius: 0; }
  }

  :global(body.nav-locked) { overflow: hidden; }
</style>
