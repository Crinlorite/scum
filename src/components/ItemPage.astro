---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localizedPath } from '../i18n/utils';
import { LANGUAGES, FALLBACK_LANG, type LangCode } from '../i18n/languages';
import { itemName, displayName, itemDescription, categoryLabel, type ScumItem } from '../data/items';
import { itemDetail } from '../data/details';
import { iconUrl } from '../data/icons';

interface Props { lang: LangCode; item: ScumItem; }
const { lang, item } = Astro.props;
const tr = useTranslations(lang);

const name = itemName(item, lang);
const dispName = displayName(item, lang);
const desc = itemDescription(item, lang);
const cat = categoryLabel(item.category, lang);
const d = itemDetail(item.slug);
const icon = iconUrl(item.slug);

const others = LANGUAGES
  .filter((l) => l.code !== lang && item.name[l.code])
  .map((l) => ({ native: l.native, code: l.code, value: item.name[l.code]! }));

// Localized field with EN→ES fallback (for crafting/recipe names).
const loc = (m?: Partial<Record<LangCode, string>>) => m?.[lang] ?? m?.[FALLBACK_LANG] ?? (m && Object.values(m)[0]) ?? '';

// Cross-link helpers: jump to a related mission/recipe/crafting entry, landing
// on the section with its search pre-filtered to that name (?q=).
const misionesBase = localizedPath('/misiones', lang);
const recetasBase = localizedPath('/recetas', lang);
const crafteoBase = localizedPath('/crafteo', lang);
const qUrl = (base: string, s: string) => `${base}?q=${encodeURIComponent(s)}`;

// In-component label maps keep i18n keys bounded; fall back to the raw key.
const L: Record<string, Partial<Record<LangCode, string>>> = {
  weight: { es: 'Peso', en: 'Weight' },
  rarity: { es: 'Rareza', en: 'Rarity' },
  maxHealth: { es: 'Durabilidad', en: 'Durability' },
  gridSlots: { es: 'Tamaño', en: 'Size' },
  warmth: { es: 'Calor', en: 'Warmth' },
  waterResistance: { es: 'Resist. agua', en: 'Water resist.' },
  camouflageBonus: { es: 'Camuflaje', en: 'Camouflage' },
  shelfLife: { es: 'Caducidad', en: 'Shelf life' },
  capacity: { es: 'Capacidad', en: 'Capacity' },
  damageOverTime: { es: 'Desgaste por uso', en: 'Wear per use' },
  canBecomeBadQuality: { es: 'Puede estropearse', en: 'Can spoil' },
  Water: { es: 'Agua', en: 'Water' }, Alcohol: { es: 'Alcohol', en: 'Alcohol' },
  Protein: { es: 'Proteína', en: 'Protein' }, TotalFat: { es: 'Grasa', en: 'Fat' },
  TotalCarbohydrate: { es: 'Carbohidratos', en: 'Carbs' }, Sugars: { es: 'Azúcares', en: 'Sugars' },
  Fiber: { es: 'Fibra', en: 'Fiber' }, Sodium: { es: 'Sodio', en: 'Sodium' },
};
const lbl = (k: string) => L[k]?.[lang] ?? L[k]?.[FALLBACK_LANG] ?? k;

// Curated stats to show (with value formatting). Weight: >1000 g shown in kg.
const st = d.stats?.stats ?? {};
const statRows: { k: string; v: string }[] = [];
const pushStat = (k: string, v: string) => statRows.push({ k: lbl(k), v });
if (typeof st.weight === 'number')
  pushStat('weight', st.weight >= 1000
    ? `${(st.weight / 1000).toLocaleString(lang, { maximumFractionDigits: 2 })} kg`
    : `${Math.round(st.weight)} g`);
if (st.rarity) pushStat('rarity', String(st.rarity));
if (typeof st.gridSlots === 'number') pushStat('gridSlots', `${st.gridRows ?? ''}×${st.gridColumns ?? ''} (${st.gridSlots})`);
if (typeof st.maxHealth === 'number') pushStat('maxHealth', String(st.maxHealth));
if (typeof st.warmth === 'number') pushStat('warmth', String(st.warmth));
if (typeof st.shelfLife === 'number') pushStat('shelfLife', String(st.shelfLife));
if (typeof st.waterResistance === 'number') pushStat('waterResistance', String(st.waterResistance));
if (typeof st.camouflageBonus === 'number') pushStat('camouflageBonus', `${Math.round(st.camouflageBonus * 100)}%`);
if (typeof st.capacity === 'number') pushStat('capacity', String(st.capacity));
if (typeof st.damageOverTime === 'number') pushStat('damageOverTime', String(st.damageOverTime));
if (typeof st.canBecomeBadQuality === 'boolean') pushStat('canBecomeBadQuality', st.canBecomeBadQuality ? (lang === 'es' ? 'Sí' : 'Yes') : 'No');

// Nutrition (curated macros present).
const nutr = d.stats?.food?.nutrients ?? {};
const NUTR_ORDER = ['Water', 'Alcohol', 'Protein', 'TotalFat', 'TotalCarbohydrate', 'Sugars', 'Fiber', 'Sodium'];
const nutrRows = NUTR_ORDER.filter((k) => typeof nutr[k] === 'number').map((k) => ({ k: lbl(k), v: nutr[k] }));
const kcal = d.stats?.food?.kcalPer100gDerived;

const w = d.weapon;
const pretty = (s: string) => s.replace(/([a-z0-9])([A-Z])/g, '$1 $2');
// Slots de attachments: el mountType del juego → categoría legible (ES/EN);
// se descartan los mounts internos del arma que no son accesorios de jugador.
const SLOT_LABELS: Record<string, { es: string; en: string }> = {
  sight: { es: 'Mira / óptica', en: 'Sight / optic' }, suppressor: { es: 'Supresor', en: 'Suppressor' },
  magazine: { es: 'Cargador', en: 'Magazine' }, flashlight: { es: 'Linterna', en: 'Flashlight' },
  laser: { es: 'Láser', en: 'Laser' }, bayonet: { es: 'Bayoneta', en: 'Bayonet' },
  stabilizer: { es: 'Estabilizador', en: 'Stabilizer' }, ghillie: { es: 'Ghillie', en: 'Ghillie' },
  charm: { es: 'Amuleto', en: 'Charm' }, grip: { es: 'Empuñadura', en: 'Grip' }, rail: { es: 'Raíl', en: 'Rail' },
};
const slotKey = (mt?: string): string | null => {
  const s = mt ?? '';
  if (/sight|optic|scope/i.test(s)) return 'sight';
  if (/silencer|suppressor|muzzle/i.test(s)) return 'suppressor';
  if (/magazine/i.test(s)) return 'magazine';
  if (/flashlight/i.test(s)) return 'flashlight';
  if (/laser/i.test(s)) return 'laser';
  if (/bayonet/i.test(s)) return 'bayonet';
  if (/stabilizer/i.test(s)) return 'stabilizer';
  if (/ghillie/i.test(s)) return 'ghillie';
  if (/charm/i.test(s)) return 'charm';
  if (/grip/i.test(s)) return 'grip';
  if (/rail/i.test(s)) return 'rail';
  return null;
};
const attachSlots: [string, number][] = w?.attachments?.length
  ? Object.entries(w.attachments.reduce((m: Record<string, number>, a) => {
      const k = slotKey(a.mountType); if (k) { const n = lang === 'es' ? SLOT_LABELS[k].es : SLOT_LABELS[k].en; m[n] = (m[n] ?? 0) + 1; } return m;
    }, {}))
  : [];
---
<BaseLayout lang={lang} title={dispName} description={desc ?? `${dispName} · ${cat} · SCUM`}>
  <article class="item-page">
    <div class="container container-prose">
      <a class="back" href={localizedPath('/items', lang)}>{tr('items.backToItems')}</a>
      <div class="hero">
        {icon && <img class="hero-icon" src={icon} alt={dispName} width="96" height="96" loading="lazy" />}
        <div>
          <span class="eyebrow">{cat}</span>
          <h1>{dispName}</h1>
        </div>
      </div>

      {desc
        ? <p class="desc">{desc}</p>
        : <p class="desc muted">{tr('items.noDescription')}</p>}

      {d.edibility && (
        <p class={`edibility edibility-${d.edibility}`}>
          {d.edibility === 'poisonous' ? `☠ ${tr('item.poisonous')}` : d.edibility === 'drink' ? `✓ ${tr('item.drinkable')}` : `✓ ${tr('item.edible')}`}
        </p>
      )}

      {statRows.length > 0 && (
        <section class="block">
          <h2>{tr('item.statsTitle')}</h2>
          <dl class="stat-grid">
            {statRows.map((r) => (<div><dt>{r.k}</dt><dd>{r.v}</dd></div>))}
          </dl>
        </section>
      )}

      {w && (
        <section class="block">
          <h2>{tr('item.weaponTitle')}</h2>
          <dl class="stat-grid">
            {typeof (w.damagePerShot ?? w.melee?.damage) === 'number' && (
              <div><dt>{tr('item.damage')}</dt><dd>{w.melee?.damage ?? w.damagePerShot}</dd></div>)}
            {w.fireModes && w.fireModes.length > 0 && (
              <div><dt>{tr('item.fireModes')}</dt><dd>{w.fireModes.join(', ')}</dd></div>)}
            {w.ammunition?.labels && w.ammunition.labels.length > 0 && (
              <div><dt>{tr('item.ammo')}</dt><dd>{w.ammunition.labels.join(', ')}</dd></div>)}
            {typeof w.magazine?.capacity === 'number' && (
              <div><dt>{tr('item.magazine')}</dt><dd>{w.magazine.capacity}</dd></div>)}
            {typeof w.maxRange === 'number' && (
              <div><dt>{tr('item.range')}</dt><dd>{w.maxRange} m</dd></div>)}
            {typeof w.rof === 'number' && w.rof > 0 && (
              <div><dt>{tr('item.rof')}</dt><dd>{w.rof}</dd></div>)}
            {w.weaponCategory && (
              <div><dt>{tr('item.weaponClass')}</dt><dd>{pretty(w.weaponCategory)}</dd></div>)}
            {typeof w.chamberCapacity === 'number' && w.chamberCapacity > 0 && (
              <div><dt>{tr('item.chamber')}</dt><dd>{w.chamberCapacity}</dd></div>)}
            {typeof w.zeroRangeStep === 'number' && w.zeroRangeStep > 0 && (
              <div><dt>{tr('item.zeroing')}</dt><dd>{w.zeroRangeStep} m</dd></div>)}
          </dl>
          {attachSlots.length > 0 && (
            <p class="attach"><strong>{tr('item.attachments')}:</strong> <span class="chips">{attachSlots.map(([n, c]) => (<span class="chip">{n}{c > 1 ? ` ×${c}` : ''}</span>))}</span></p>
          )}
        </section>
      )}

      {(kcal != null || nutrRows.length > 0) && (
        <section class="block">
          <h2>{tr('item.nutritionTitle')}</h2>
          <dl class="stat-grid">
            {kcal != null && (<div><dt>{tr('item.calories')}</dt><dd>{kcal} kcal</dd></div>)}
            {nutrRows.map((r) => (<div><dt>{r.k}</dt><dd>{r.v}</dd></div>))}
          </dl>
        </section>
      )}

      {d.container && (d.container.slots || d.container.maxWeightKg) && (
        <section class="block">
          <h2>{tr('item.storage')}</h2>
          <dl class="stat-grid">
            {d.container.rows && d.container.cols && (<div><dt>{tr('item.capacity')}</dt><dd>{d.container.rows} × {d.container.cols}</dd></div>)}
            {typeof d.container.slots === 'number' && (<div><dt>{tr('item.slots')}</dt><dd>{d.container.slots.toLocaleString(lang)}</dd></div>)}
            {typeof d.container.maxWeightKg === 'number' && (<div><dt>{tr('item.maxWeight')}</dt><dd>{d.container.maxWeightKg.toLocaleString(lang)} kg</dd></div>)}
          </dl>
        </section>
      )}

      {d.ammo && (
        <section class="block">
          <h2>{tr('item.ballistics')}</h2>
          <dl class="stat-grid">
            {typeof d.ammo.damage === 'number' && (<div><dt>{tr('item.ammoDamage')}</dt><dd>{d.ammo.damage}</dd></div>)}
            {typeof d.ammo.muzzleVel === 'number' && (<div><dt>{tr('item.muzzleVel')}</dt><dd>{d.ammo.muzzleVel} m/s</dd></div>)}
            {typeof d.ammo.caliber === 'number' && (<div><dt>{tr('item.caliber')}</dt><dd>{d.ammo.caliber} mm</dd></div>)}
            {typeof d.ammo.penetration === 'number' && (<div><dt>{tr('item.penetration')}</dt><dd>{d.ammo.penetration}</dd></div>)}
            {typeof d.ammo.ballisticCoef === 'number' && (<div><dt>{tr('item.bcoef')}</dt><dd>{d.ammo.ballisticCoef}</dd></div>)}
          </dl>
        </section>
      )}

      {d.clothing && (
        <section class="block">
          <h2>{tr('item.protection')}</h2>
          <dl class="stat-grid">
            {typeof d.clothing.ballistic === 'number' && (<div><dt>{tr('item.ballistic')}</dt><dd>{d.clothing.ballistic.toLocaleString(lang)}</dd></div>)}
            {typeof d.clothing.sharp === 'number' && (<div><dt>{tr('item.sharpRed')}</dt><dd>−{d.clothing.sharp}%</dd></div>)}
            {typeof d.clothing.blunt === 'number' && (<div><dt>{tr('item.bluntRed')}</dt><dd>−{d.clothing.blunt}%</dd></div>)}
            {typeof d.clothing.warmth === 'number' && (<div><dt>{tr('item.warmth')}</dt><dd>{d.clothing.warmth}</dd></div>)}
            {typeof d.clothing.waterRes === 'number' && (<div><dt>{tr('item.waterRes')}</dt><dd>{d.clothing.waterRes}</dd></div>)}
            {typeof d.clothing.camo === 'number' && (<div><dt>{tr('item.camo')}</dt><dd>{d.clothing.camo > 0 ? '+' : ''}{d.clothing.camo}%</dd></div>)}
          </dl>
        </section>
      )}

      {d.craftedBy.length > 0 && (
        <section class="block">
          <h2>{tr('item.howToCraft')}</h2>
          {d.craftedBy.slice(0, 4).map((c) => (
            <div class="recipe">
              <a class="chip" href={qUrl(crafteoBase, loc(c.name) || dispName)}>{loc(c.name) || dispName}</a>
              <ul class="ingredients">
                {(c.ingredients ?? []).map((ing) => (
                  <li>{(ing.options ?? []).map((o) => loc(o.name)).filter(Boolean).join(' / ')}</li>
                ))}
              </ul>
              <p class="recipe-meta">
                {c.skill && <span>{tr('item.skill')}: {c.skill}</span>}
                {typeof c.duration === 'number' && <span>{tr('item.craftTime')}: {Math.round(c.duration)} s</span>}
                {typeof c.productQuantity === 'number' && c.productQuantity > 1 && <span>×{c.productQuantity}</span>}
              </p>
            </div>
          ))}
        </section>
      )}

      {d.cookingUsing.length > 0 && (
        <section class="block">
          <h2>{tr('item.usedInCooking')}</h2>
          <div class="chips">{d.cookingUsing.slice(0, 20).map((r) => { const t = loc(r.name); return t ? <a class="chip" href={qUrl(recetasBase, t)}>{t}</a> : null; })}</div>
        </section>
      )}

      {d.cookedHere.length > 0 && (
        <section class="block">
          <h2>{tr('item.cookedHere')}</h2>
          <div class="chips">{d.cookedHere.map((r) => { const t = loc(r.name); return t ? <a class="chip" href={localizedPath(`/recetas/${r.slug}`, lang)}>{t}</a> : null; })}</div>
        </section>
      )}

      {d.craftingUsing.length > 0 && (
        <section class="block">
          <h2>{tr('item.usedInCrafting')}</h2>
          <div class="chips">{d.craftingUsing.slice(0, 40).map((c) => { const t = loc(c.name); return t ? <a class="chip" href={localizedPath(`/crafteo/${c.slug}`, lang)}>{t}</a> : null; })}</div>
        </section>
      )}

      {d.loot?.spawns && d.loot.spawns.length > 0 && (
        <section class="block">
          <h2>{tr('item.whereFound')}</h2>
          <p class="cooking-list">{d.loot.spawns.map((s) => `${pretty(s.location)}${s.rarity ? ` (${pretty(s.rarity)})` : ''}`).join(' · ')}</p>
        </section>
      )}

      {d.economy && (d.economy.canBuy || d.economy.canSell) && (
        <section class="block">
          <h2>{tr('item.trade')}</h2>
          <dl class="stat-grid">
            {typeof d.economy.buyPrice === 'number' && (<div><dt>{tr('item.buyPrice')}</dt><dd>{d.economy.buyPrice.toLocaleString(lang)} ¥</dd></div>)}
            {typeof d.economy.sellPrice === 'number' && (<div><dt>{tr('item.sellPrice')}</dt><dd>{d.economy.sellPrice.toLocaleString(lang)} ¥</dd></div>)}
            {d.economy.traders && d.economy.traders.length > 0 && (<div><dt>{tr('item.traders')}</dt><dd>{d.economy.traders.map(pretty).join(', ')}</dd></div>)}
            {typeof d.economy.requiredFame === 'number' && d.economy.requiredFame > 0 && (<div><dt>{tr('item.fame')}</dt><dd>{d.economy.requiredFame}</dd></div>)}
          </dl>
        </section>
      )}

      {d.packagedAs && (
        <section class="block">
          <h2>{tr('item.soldAsPack')}</h2>
          <p class="cooking-list"><a class="chip" href={localizedPath(`/items/${d.packagedAs.slug}`, lang)}>{loc(d.packagedAs.name) || d.packagedAs.slug}</a>{typeof d.packagedAs.sellPrice === 'number' ? ` · ${tr('item.sellPrice')}: ${d.packagedAs.sellPrice.toLocaleString(lang)} ¥` : ''}</p>
        </section>
      )}

      {d.questsNeeding.length > 0 && (
        <section class="block">
          <h2>{tr('item.questNeeded')}</h2>
          <div class="chips">{d.questsNeeding.slice(0, 15).map((q) => { const t = loc(q.title); return t ? <a class="chip" href={qUrl(misionesBase, t)}>{t}</a> : null; })}</div>
        </section>
      )}

      {d.questsRewarding.length > 0 && (
        <section class="block">
          <h2>{tr('item.questReward')}</h2>
          <div class="chips">{d.questsRewarding.slice(0, 15).map((q) => { const t = loc(q.title); return t ? <a class="chip" href={qUrl(misionesBase, t)}>{t}</a> : null; })}</div>
        </section>
      )}

      <dl class="meta">
        <div><dt>{tr('items.category')}</dt><dd>{cat}</dd></div>
        <div><dt>{tr('items.officialName')}</dt><dd>{item.name[lang] ?? name}</dd></div>
        <div><dt>ID</dt><dd><code>{item.asset}</code></dd></div>
      </dl>

      {others.length > 0 && (
        <section class="other-langs">
          <h2>{tr('items.otherLanguages')}</h2>
          <ul>
            {others.map((o) => (
              <li>
                <span class="lang-name" lang={o.code}>{o.native}</span>
                <span class="lang-value" lang={o.code}>{o.value}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .item-page { padding: 3rem 0 4rem; }
  .back { display: inline-block; margin-bottom: 1.5rem; color: var(--c-ink-soft); text-decoration: none; font-size: 0.9rem; }
  .back:hover { color: var(--c-rust); }
  h1 { margin: 0.3rem 0 1rem; }
  .hero { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem; }
  .hero > div { min-width: 0; }
  .hero h1 { margin: 0.2rem 0 0; }
  .hero-icon { flex: none; width: 96px; height: 96px; object-fit: contain; padding: 6px; background: var(--c-paper); border: 1px solid var(--c-rule); border-radius: var(--radius); }
  .desc { font-size: 1.15rem; color: var(--c-ink); line-height: 1.6; }
  .desc.muted { color: var(--c-ink-muted); font-style: italic; }
  .edibility { display: inline-block; margin: 0.2rem 0 0.6rem; padding: 0.25rem 0.7rem; border-radius: 999px; font-size: 0.9rem; font-weight: 600; }
  .edibility-edible, .edibility-drink { background: rgba(74, 122, 56, 0.18); color: #6fae4e; border: 1px solid rgba(111, 174, 78, 0.4); }
  .edibility-poisonous { background: rgba(176, 58, 46, 0.18); color: #e06a5a; border: 1px solid rgba(224, 106, 90, 0.5); }
  .block { margin: 1.75rem 0; }
  .block h2 { font-size: 1.05rem; margin: 0 0 0.75rem; }
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: 0.6rem 1rem; margin: 0; }
  .stat-grid > div { display: flex; flex-direction: column; }
  .stat-grid dt { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--c-ink-muted); }
  .stat-grid dd { margin: 0; color: var(--c-ink); font-weight: 600; }
  .recipe { padding: 0.75rem 0.9rem; background: var(--c-paper); border: 1px solid var(--c-rule); border-radius: var(--radius); margin-bottom: 0.6rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip {
    display: inline-flex; align-items: center; padding: 0.28rem 0.6rem;
    font-size: 0.85rem; color: var(--c-ink-soft); background: var(--c-paper-soft);
    border: 1px solid var(--c-rule); border-radius: 999px; text-decoration: none;
    transition: color 120ms ease, border-color 120ms ease;
  }
  .chip:hover { color: var(--c-ink); border-color: var(--c-rust); }
  .recipe .chip { margin-bottom: 0.5rem; }
  .ingredients { margin: 0 0 0.4rem; padding-left: 1.1rem; color: var(--c-ink); }
  .ingredients li { margin: 0.1rem 0; }
  .recipe-meta { margin: 0; display: flex; flex-wrap: wrap; gap: 1rem; font-size: 0.82rem; color: var(--c-ink-muted); }
  .cooking-list { margin: 0; color: var(--c-ink-soft); line-height: 1.7; }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1rem 1.5rem; margin: 2rem 0; padding: 1.25rem 0; border-block: 1px solid var(--c-rule); }
  .meta dt { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--c-ink-muted); margin-bottom: 0.2rem; }
  .meta dd { margin: 0; color: var(--c-ink); }
  .meta code { font-family: var(--font-mono); font-size: 0.85rem; color: var(--c-ink-soft); }
  .other-langs h2 { font-size: 1.1rem; margin-bottom: 0.75rem; }
  .other-langs ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.3rem; }
  .other-langs li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.45rem 0; border-bottom: 1px solid var(--c-rule); }
  .lang-name { color: var(--c-ink-muted); font-size: 0.9rem; }
  .lang-value { color: var(--c-ink); text-align: right; }
</style>
