---
import { useTranslations } from '../i18n/utils';
import type { LangCode } from '../i18n/languages';
import { SERVER_INFO } from '../data/server';

interface Props { lang: LangCode; }
const { lang } = Astro.props;
const tr = useTranslations(lang);
const statusKey =
  SERVER_INFO.status === 'online' ? 'server.statusOnline'
  : SERVER_INFO.status === 'offline' ? 'server.statusOffline'
  : 'server.statusUnknown';
const statusClass = SERVER_INFO.status ?? 'unknown';
---
<section class="server" id="server">
  <div class="container server-inner">
    <div class="server-text">
      <span class="eyebrow">{tr('nav.server')}</span>
      <h2>{tr('server.title')}</h2>
      <p>{tr('server.subtitle')}</p>
      <p class="server-family">{tr('server.familyNote')}</p>
    </div>
    <div class="server-card">
      <dl>
        <div>
          <dt>{tr('server.name')}</dt>
          <dd><code>{SERVER_INFO.name}</code></dd>
        </div>
        <div>
          <dt>{tr('server.address')}</dt>
          <dd><code>{SERVER_INFO.address}</code></dd>
        </div>
        <div>
          <dt>{tr('server.status')}</dt>
          <dd>
            <span class={`status-dot status-${statusClass}`} aria-hidden="true"></span>
            <span>{tr(statusKey)}</span>
          </dd>
        </div>
        <div>
          <dt>{tr('server.connect')}</dt>
          <dd>{tr('server.howToJoin')}</dd>
        </div>
      </dl>
      <p class="server-note">{tr('server.note')}</p>
    </div>
  </div>
</section>

<style>
  .server {
    padding: clamp(4rem, 8vw, 6rem) 0;
    background: var(--c-paper-soft);
    border-top: 1px solid var(--c-rule);
    border-bottom: 1px solid var(--c-rule);
  }
  .server-inner {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    align-items: center;
  }
  .server-text h2 { margin: 0.5rem 0 0.75rem; }
  .server-text p { color: var(--c-ink-soft); margin: 0; }
  .server-family {
    margin-top: 0.85rem !important;
    padding: 0.6rem 0.8rem;
    font-size: 0.9rem;
    color: var(--c-ink) !important;
    background: var(--c-paper);
    border-left: 3px solid var(--c-rust);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .server-card {
    background: var(--c-paper);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-card);
  }
  dl { margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  dl > div { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; align-items: baseline; }
  dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-ink-muted);
  }
  dd { margin: 0; color: var(--c-ink); }
  dd code { font-size: 0.95rem; }
  .status-dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    margin-right: 0.5rem;
    vertical-align: middle;
  }
  .status-online  { background: #3fb950; box-shadow: 0 0 8px rgba(63, 185, 80, 0.5); }
  .status-offline { background: #c83a3a; }
  .status-unknown { background: var(--c-ink-muted); }
  .server-note {
    margin: 1.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px dashed var(--c-rule);
    font-size: 0.85rem;
    color: var(--c-ink-muted);
  }
  @media (max-width: 720px) {
    .server-inner { grid-template-columns: 1fr; gap: 1.5rem; }
    dl > div { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
