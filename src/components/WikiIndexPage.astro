---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localizedPath } from '../i18n/utils';
import { WIKI_CATEGORIES, loadWiki } from '../i18n/wiki';
import { codexByCategory } from '../data/codex';
import type { LangCode } from '../i18n/languages';

interface Props { lang: LangCode; }
const { lang } = Astro.props;
const tr = useTranslations(lang);

const entries = await loadWiki();
const counts: Record<string, number> = {};
for (const c of WIKI_CATEGORIES) counts[c] = 0;
for (const e of entries) {
  if (e.parsed.lang === lang) counts[e.parsed.category]++;
}
const codexGroups = codexByCategory(lang);
const manualBase = localizedPath('/manual', lang);
const lp = (p: string) => localizedPath(p, lang);
const catGroups = [
  { label: tr('wiki.catObjects'), items: [
    { href: lp('/items'), label: tr('nav.items') },
    { href: lp('/armas'), label: tr('sec.weapons.title') },
    { href: lp('/recetas'), label: tr('recipes.title') },
    { href: lp('/crafteo'), label: tr('crafting.title') },
  ] },
  { label: tr('wiki.catCharacter'), items: [
    { href: lp('/skills'), label: tr('sec.skills.title') },
    { href: lp('/medico'), label: tr('sec.medical.title') },
    { href: lp('/fama'), label: tr('sec.fame.title') },
    { href: lp('/controles'), label: tr('sec.controls.title') },
  ] },
  { label: tr('wiki.catWorld'), items: [
    { href: lp('/misiones'), label: tr('sec.quests.title') },
    { href: lp('/caza'), label: tr('sec.hunting.title') },
    { href: lp('/vehiculos'), label: tr('sec.vehicles.title') },
    { href: lp('/mapa'), label: tr('nav.map') },
  ] },
];
---
<BaseLayout
  lang={lang}
  title={tr('wiki.title')}
  description={tr('wiki.intro')}
>
  <section class="wiki-index">
    <div class="container container-prose">
      <span class="eyebrow">{tr('wiki.title')}</span>
      <h1>{tr('wiki.title')}</h1>
      <p class="intro">{tr('wiki.intro')}</p>
    </div>
    <div class="container">
      <div class="grid">
        {WIKI_CATEGORIES.map((c) => {
          const n = counts[c];
          const key = n === 1 ? 'wiki.articleCountOne' : 'wiki.articleCountOther';
          return (
            <a class="card" href={localizedPath(`/wiki/${c}`, lang)}>
              <h3>{tr(`cat.${c}.title` as const)}</h3>
              <p>{tr(`cat.${c}.desc` as const)}</p>
              <span class="count">{tr(key, { n })}</span>
            </a>
          );
        })}
      </div>

      <h2 class="sec-h">{tr('manual.title')}</h2>
      <p class="sec-sub">{tr('manual.intro')}</p>
      <div class="grid">
        {codexGroups.map((g) => {
          const key = g.entries.length === 1 ? 'wiki.articleCountOne' : 'wiki.articleCountOther';
          return (
            <a class="card" href={`${manualBase}#mcat-${g.cat}`}>
              <h3>{g.label}</h3>
              <span class="count">{tr(key, { n: g.entries.length })}</span>
            </a>
          );
        })}
      </div>

      <h2 class="sec-h">{tr('wiki.catalogues')}</h2>
      {catGroups.map((g) => (
        <div class="cat-block">
          <h3 class="cat-label">{g.label}</h3>
          <div class="grid">
            {g.items.map((d) => (<a class="card data-card" href={d.href}><h3>{d.label}</h3></a>))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .wiki-index { padding: 3rem 0 4rem; }
  .intro { color: var(--c-ink-soft); font-size: 1.1rem; margin-bottom: 2.5rem; }
  .sec-h { margin: 3rem 0 0.25rem; font-size: 1.3rem; }
  .sec-sub { color: var(--c-ink-soft); margin: 0 0 1.25rem; font-size: 0.95rem; }
  .cat-block { margin-top: 1.5rem; }
  .cat-label { margin: 0 0 0.75rem; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c-ink-muted); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }
  .count {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--c-ink-muted);
  }
</style>
