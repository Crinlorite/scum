---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localizedPath } from '../i18n/utils';
import { codexTitle, codexDesc, codexCategoryLabel, blockText, type CodexArticle } from '../data/codex';
import type { LangCode } from '../i18n/languages';

interface Props { lang: LangCode; article: CodexArticle; }
const { lang, article } = Astro.props;
const tr = useTranslations(lang);
const title = codexTitle(article, lang);
const desc = codexDesc(article, lang);
const cat = codexCategoryLabel(article.category, lang);
// Codex image textures aren't exported yet (separate texture dump) — text blocks
// render now; images appear once /manual-img/ is populated.
const blocks = article.blocks.map((b) => ({ ...b, str: b.t === 'image' ? '' : blockText(b, lang) })).filter((b) => b.t === 'image' || b.str);
---
<BaseLayout lang={lang} title={title} description={desc || `${title} · ${tr('manual.title')}`}>
  <article class="codex">
    <div class="container container-prose">
      <a class="back" href={localizedPath('/manual', lang)}>← {tr('manual.title')}</a>
      <span class="eyebrow">{cat}</span>
      <h1>{title}</h1>
      {desc && <p class="lead">{desc}</p>}
      {blocks.map((b) => (
        b.t === 'title' ? <h2>{b.str}</h2>
        : b.t === 'text' ? <p>{b.str}</p>
        : null
      ))}
      <p class="source">{tr('manual.source')}</p>
    </div>
  </article>
</BaseLayout>

<style>
  .codex { padding: 2.5rem 0 4rem; }
  .back { display: inline-block; margin-bottom: 1rem; color: var(--c-ink-soft); text-decoration: none; font-size: 0.9rem; }
  .back:hover { color: var(--c-rust); }
  .codex h1 { margin: 0.3rem 0 0.75rem; }
  .lead { color: var(--c-ink-soft); font-size: 1.15rem; line-height: 1.6; margin-bottom: 1.5rem; }
  .codex h2 { font-size: 1.15rem; margin: 1.75rem 0 0.6rem; }
  .codex p { color: var(--c-ink); line-height: 1.7; margin: 0 0 0.9rem; white-space: pre-line; }
  .source { color: var(--c-ink-muted); font-size: 0.8rem; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--c-rule); }
</style>
