---
// Single-button language switcher with a dropdown panel (desktop & mobile).
// Uses native <details> so it works without JS; a tiny script adds
// click-outside / Esc to close. Languages are grouped Stable / Beta.
import { getAllLocales, alternateHref, useTranslations } from '../i18n/utils';
import { getLanguageMeta, type LangCode } from '../i18n/languages';

interface Props { lang: LangCode; }
const { lang } = Astro.props;
const tr = useTranslations(lang);
const here = Astro.url.pathname;

const all = getAllLocales();
const stable = all.filter((l) => !l.beta);
const beta = all.filter((l) => l.beta);
const current = getLanguageMeta(lang);
const HELP_URL = 'https://github.com/Crinlorite/scum';
---
<details class="lang-switcher">
  <summary aria-label={tr('lang.label')} title={tr('lang.label')}>
    <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
    </svg>
    <span class="ls-current">{current.native}</span>
    <svg class="ls-chev" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </summary>

  <div class="ls-panel">
    <p class="ls-group">{tr('lang.stable')}</p>
    <ul>
      {stable.map((l) => (
        <li>
          <a href={alternateHref(here, lang, l.code)} hreflang={l.code} lang={l.code}
             class={l.code === lang ? 'active' : ''}
             aria-current={l.code === lang ? 'true' : undefined}>
            <span class="ls-native">{l.native}</span>
            <span class="ls-code">{l.code.toUpperCase()}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="ls-group">{tr('lang.beta')}</p>
    <ul>
      {beta.map((l) => (
        <li>
          <a href={alternateHref(here, lang, l.code)} hreflang={l.code} lang={l.code}
             class={l.code === lang ? 'active' : ''}
             aria-current={l.code === lang ? 'true' : undefined}>
            <span class="ls-native">{l.native}</span>
            <span class="ls-beta">{tr('beta.badge')}</span>
          </a>
        </li>
      ))}
    </ul>

    <a class="ls-help" href={HELP_URL}>{tr('lang.help')}</a>
  </div>
</details>

<script>
  for (const d of document.querySelectorAll<HTMLDetailsElement>('details.lang-switcher')) {
    document.addEventListener('click', (e) => {
      if (d.open && !d.contains(e.target as Node)) d.open = false;
    });
    d.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') { d.open = false; d.querySelector('summary')?.focus(); }
    });
  }
</script>

<style>
  .lang-switcher { position: relative; }
  .lang-switcher summary {
    display: inline-flex; align-items: center; gap: 0.35rem;
    list-style: none; cursor: pointer; user-select: none;
    padding: 0.35rem 0.55rem;
    color: var(--c-ash);
    border: 1px solid rgba(232, 227, 216, 0.12); border-radius: 6px;
    font-family: var(--font-display); font-size: 0.82rem; font-weight: 600;
    letter-spacing: 0.04em;
    transition: color 120ms ease, border-color 120ms ease;
  }
  .lang-switcher summary::-webkit-details-marker { display: none; }
  .lang-switcher summary:hover { color: var(--c-bone); border-color: var(--c-rust); }
  .lang-switcher[open] summary { color: var(--c-bone); border-color: var(--c-rust); }
  .ls-current { max-width: 8rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ls-chev { transition: transform 150ms ease; opacity: 0.7; }
  .lang-switcher[open] .ls-chev { transform: rotate(180deg); }

  .ls-panel {
    position: absolute; top: calc(100% + 6px); right: 0;
    width: min(17rem, 82vw);
    background: var(--c-bg-panel, #1a1f1c);
    border: 1px solid rgba(232, 227, 216, 0.12);
    border-radius: 8px; padding: 0.5rem;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45); z-index: 60;
  }
  .ls-group {
    margin: 0.35rem 0.4rem 0.2rem; padding: 0;
    font-size: 0.62rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--c-steel);
  }
  .ls-panel ul { list-style: none; margin: 0 0 0.4rem; padding: 0; }
  .ls-panel a {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.4rem 0.5rem; border-radius: 5px;
    color: var(--c-ash); text-decoration: none; font-size: 0.92rem;
  }
  .ls-panel a:hover { color: var(--c-bone); background: rgba(232, 227, 216, 0.06); }
  .ls-panel a.active { color: var(--c-rust-bright); background: rgba(176, 74, 42, 0.14); }
  .ls-native { flex: 1 1 auto; }
  .ls-code { font-size: 0.68rem; color: var(--c-steel); font-family: var(--font-mono); }
  .ls-beta {
    font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    color: #d9a441; background: rgba(217, 164, 65, 0.16);
    padding: 0.05rem 0.35rem; border-radius: 999px;
  }
  .ls-help {
    display: block; margin-top: 0.2rem; padding: 0.5rem 0.5rem 0.3rem;
    border-top: 1px solid rgba(232, 227, 216, 0.1);
    color: var(--c-steel); font-size: 0.78rem; text-decoration: none;
  }
  .ls-help:hover { color: var(--c-rust-bright); }
</style>
